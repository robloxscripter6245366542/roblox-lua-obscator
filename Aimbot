-- ============================================================
-- TARGETING HELPERS
-- ============================================================
-- Rivals PlayerStatus values that mean the player is not a live combatant.
-- A player in any of these is a "ghost" and must never be locked.
local GHOST_STATUS = {
	Lobby = true,
	Dead = true,
	Spectate = true,
	Spectating = true,
	Respawning = true,
	Eliminated = true,
	Menu = true,
}

-- True when the player is in the lobby / dead / spectating / respawning.
-- Uses Rivals' own PlayerStatus attribute; unknown/absent values fail open
-- so ordinary games (no such attribute) are unaffected.
local function isGhost(p)
	local status = p:GetAttribute("PlayerStatus")
	return type(status) == "string" and GHOST_STATUS[status] == true
end

local function isFriendly(p)
	if not Settings.TeamCheck then return false end
	-- Rivals: TeamID attribute is the authoritative team check.
	local myId = lp:GetAttribute("TeamID")
	local theirId = p:GetAttribute("TeamID")
	if myId ~= nil and theirId ~= nil then
		return myId == theirId
	end
	-- Fallback for games without TeamID: standard Team property.
	if lp.Team == nil then return false end
	return p.Team ~= nil and p.Team == lp.Team
end

local function getHitPart(char)
	local want = Settings.TargetPart
	if want == "Torso" then
		return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
			or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
	elseif want == "HumanoidRootPart" then
		return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
	end
	return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function getVelocity(char, part)
	local src = char:FindFirstChild("HumanoidRootPart") or part
	if not src then return Vector3.zero end
	local ok, v = pcall(function() return src.AssemblyLinearVelocity end)
	if ok and typeof(v) == "Vector3" then return v end
	ok, v = pcall(function() return src.Velocity end)
	if ok and typeof(v) == "Vector3" then return v end
	return Vector3.zero
end

-- Predicted aim point: lead the target by its velocity so a moving
-- target is tracked instead of trailed. Lead is measured in seconds.
local function getAimPoint(char, part)
	local pos = part.Position
	if not Settings.Prediction then return pos end
	local vel = getVelocity(char, part)
	if vel.Magnitude < 1 then return pos end
	return pos + vel * Settings.PredictionAmount
end

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true

-- True when nothing solid sits between the camera and the target part.
-- If a wall (or any instance that is not part of the target) is hit first,
-- the target is behind cover and must not be locked.
local function hasLineOfSight(char, part)
	if not Settings.WallCheck then return true end
	local origin = cam.CFrame.Position
	-- Ignore our own character so a held tool / hat never counts as a wall.
	raycastParams.FilterDescendantsInstances = { lp.Character, char, cam }
	local hit = workspace:Raycast(origin, part.Position - origin, raycastParams)
	-- Nothing between us and the target -> visible. Anything else -> blocked.
	return hit == nil
end

local function isValidTarget(p)
	if p == lp or isFriendly(p) or isGhost(p) then return false end
	local char = p.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	local part = getHitPart(char)
	if not part then return nil end
	return char, part, hum
end

-- Closest valid target to the screen centre, within FOV & (optionally) LOS.
local function acquireTarget(center)
	local bestChar, bestPart
	local closest = Settings.Fov
	for _, p in ipairs(Players:GetPlayers()) do
		local char, part = isValidTarget(p)
		if char and part then
			local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
			if onScreen then
				local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
				if dist < closest and hasLineOfSight(char, part) then
					closest = dist
					bestChar, bestPart = char, part
				end
			end
		end
	end
	return bestChar, bestPart
end

-- Evaluate a locked character. Returns (aimPart, hardInvalid).
--   aimPart      -> the part to aim at right now, or nil if not aimable
--   hardInvalid  -> true only when the lock must be dropped immediately
--                   (dead, despawned, teammate, or gone ghost:
--                   lobby/spectate/respawning). Soft losses
--                   (off-screen, behind a wall, out of FOV) return nil,false
--                   so the caller can hold the target through the blip.
local function evalLocked(char, center)
	if not char or not char.Parent then return nil, true end
	local p = Players:GetPlayerFromCharacter(char)
	if not p or isFriendly(p) or isGhost(p) then return nil, true end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil, true end
	local part = getHitPart(char)
	if not part then return nil, false end
	local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
	if not onScreen then return nil, false end
	if not Settings.StickyIgnoreFOV then
		local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
		if dist > Settings.Fov then return nil, false end
	end
	if not hasLineOfSight(char, part) then return nil, false end
	return part, false
end

-- ============================================================
-- AIM LOOP
-- ============================================================
local lockedChar = nil
local lockGrace = 0

track(RunService.RenderStepped:Connect(function(dt)
	cam = workspace.CurrentCamera or cam
	if not cam or not lp.Character then return end

	local center = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)

	if Settings.RainbowUI then
		local rainbow = Color3.fromHSV((tick() % 3) / 3, 0.9, 1)
		mainStroke.Color = rainbow
		fovStroke.Color = rainbow
		tStroke.Color = rainbow
		for _, el in ipairs(rainbowElements) do
			el.BackgroundColor3 = rainbow
		end
	end

	fovCircle.Visible = Settings.MasterEnabled and Settings.Aimbot and Settings.ShowFOV
	fovCircle.Position = UDim2.new(0, center.X, 0, center.Y)
	fovCircle.Size = UDim2.new(0, Settings.Fov * 2, 0, Settings.Fov * 2)

	if not Settings.MasterEnabled or not Settings.Aimbot then
		lockedChar = nil
		return
	end

	-- Sticky target with a grace window: keep the current lock through brief
	-- off-screen / wall / dodge frames instead of instantly switching to
	-- another player. Only drop on a hard loss (dead / gone / teammate) or
	-- once the grace window elapses.
	local char, part
	if Settings.StickyTarget and lockedChar then
		local keepPart, hardInvalid = evalLocked(lockedChar, center)
		if keepPart then
			char, part = lockedChar, keepPart
			lockGrace = 0
		elseif hardInvalid then
			lockedChar = nil
			lockGrace = 0
		else
			lockGrace = lockGrace + dt
			if lockGrace <= LOCK_GRACE then
				return -- hold this target, wait for it to reappear
			end
			lockedChar = nil
			lockGrace = 0
		end
	end
	if not char then
		char, part = acquireTarget(center)
		lockedChar = char
		lockGrace = 0
	end

	if char and part then
		local origin = cam.CFrame.Position
		local aimPos = getAimPoint(char, part)
		local goal = CFrame.new(origin, aimPos)
		local strength = math.clamp(Settings.Strength, 0.05, 1)
		if not Settings.Smoothing or strength >= 0.99 then
			cam.CFrame = goal
		else
			-- Smooth acquire, then hard-lock on the head: once the crosshair
			-- is within a small angle of the target it snaps fully and stays
			-- glued, so it tracks the head tightly instead of trailing it.
			local wantDir = aimPos - origin
			if wantDir.Magnitude <= 0 then
				cam.CFrame = goal
			else
				local dot = math.clamp(cam.CFrame.LookVector:Dot(wantDir.Unit), -1, 1)
				if math.acos(dot) <= HARD_LOCK_ANGLE then
					cam.CFrame = goal
				else
					-- Frame-rate independent smoothing: same feel at any FPS.
					local alpha = 1 - (1 - strength) ^ (dt * 60)
					cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(alpha, 0, 1))
				end
			end
		end
	else
		lockedChar = nil
	end
end))

