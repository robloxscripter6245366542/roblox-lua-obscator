local function createToggle(txt, settingKey)
	local b = Instance.new("TextButton", body)
	b.Size = UDim2.new(1, 0, 0, 30)
	b.LayoutOrder = nextOrder()
	b.Font = Enum.Font.Code
	b.TextSize = 12
	b.AutoButtonColor = false
	b.ZIndex = 6
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

	local function updateState()
		local st = Settings[settingKey]
		b.Text = txt .. ": " .. (st and "ENABLED" or "DISABLED")
		b.BackgroundColor3 = st and Color3.fromRGB(25, 60, 35) or Color3.fromRGB(25, 25, 30)
		b.TextColor3 = st and Color3.fromRGB(100, 255, 140) or Color3.fromRGB(180, 180, 180)
	end

	track(b.MouseButton1Click:Connect(function()
		Settings[settingKey] = not Settings[settingKey]
		updateState()
		SaveSettings()
	end))
	updateState()
end

local function createSlider(name, min, max, settingKey, isFloat)
	local function fmt(v)
		if v >= (max * 0.99) then return "MAX" end
		if isFloat then return string.format("%.2f", v) end
		return tostring(math.floor(v))
	end

	local label = Instance.new("TextLabel", body)
	label.Size = UDim2.new(1, 0, 0, 16)
	label.LayoutOrder = nextOrder()
	label.Text = name .. ": " .. fmt(Settings[settingKey])
	label.TextColor3 = Color3.fromRGB(200, 200, 200)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Code
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextSize = 11
	label.ZIndex = 6

	local bg = Instance.new("Frame", body)
	bg.Size = UDim2.new(1, 0, 0, 8)
	bg.LayoutOrder = nextOrder()
	bg.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
	bg.Active = true
	bg.ZIndex = 6
	Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

	local initPos = math.clamp((Settings[settingKey] - min) / (max - min), 0, 1)
	local fill = Instance.new("Frame", bg)
	fill.Size = UDim2.new(initPos, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
	fill.ZIndex = 7
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
	rainbowElements[#rainbowElements + 1] = fill

	local knob = Instance.new("TextButton", bg)
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.Position = UDim2.new(initPos, -9, 0.5, -9)
	knob.Text = ""
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.ZIndex = 8
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local dragging = false
	local function update(input)
		local pos = math.clamp((input.Position.X - bg.AbsolutePosition.X) / math.max(bg.AbsoluteSize.X, 1), 0, 1)
		fill.Size = UDim2.new(pos, 0, 1, 0)
		knob.Position = UDim2.new(pos, -9, 0.5, -9)
		local val = min + (max - min) * pos
		if not isFloat then val = math.floor(val + 0.5) end
		Settings[settingKey] = val
		label.Text = name .. ": " .. fmt(val)
	end

	local function beginDrag(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end
	track(knob.InputBegan:Connect(beginDrag))
	track(bg.InputBegan:Connect(beginDrag))

	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			SaveSettings()
		end
	end))
end

local function createCycle(name, settingKey, options)
	local b = Instance.new("TextButton", body)
	b.Size = UDim2.new(1, 0, 0, 30)
	b.LayoutOrder = nextOrder()
	b.Font = Enum.Font.Code
	b.TextSize = 12
	b.AutoButtonColor = false
	b.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	b.TextColor3 = Color3.fromRGB(220, 220, 220)
	b.ZIndex = 6
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

	local function refresh()
		b.Text = name .. ": " .. tostring(Settings[settingKey])
	end

	track(b.MouseButton1Click:Connect(function()
		local cur = 1
		for i, opt in ipairs(options) do
			if opt == Settings[settingKey] then cur = i break end
		end
		Settings[settingKey] = options[(cur % #options) + 1]
		refresh()
		SaveSettings()
	end))
	refresh()
end

