--!nocheck
-- Compact iPad FOV Aimbot
-- Small vertical touch UI. One toggle turns everything on:
--   * draws a FOV circle at the screen centre
--   * automatically locks the camera onto any target inside the circle
--   * auto-switches to the closest target when several are inside the circle
--   * FOV radius is adjustable from 10 up to 300
-- Self contained: no external loaders, works on iPad / mobile executors.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Clean up a previous run of this script (re-execute friendly)
local genv = (getgenv and getgenv()) or _G
if type(genv.__ipadFovCleanup) == "function" then
	pcall(genv.__ipadFovCleanup)
end

-- ============================================================
-- Settings
-- ============================================================
local FOV_MIN = 10
local FOV_MAX = 300

local state = {
	enabled = false,   -- master toggle: auto FOV lock
	fov = 120,         -- circle radius in pixels
	smooth = 1,        -- 1 = instant hard lock, lower = smoother
	teamCheck = true,  -- don't lock teammates when the game has teams
}

local conns = {}
local function track(c)
	table.insert(conns, c)
	return c
end

-- ============================================================
-- GUI host (protected container when the executor supports it)
-- ============================================================
local function getGuiParent()
	if gethui then
		local ok, hui = pcall(gethui)
		if ok and hui then
			return hui
		end
	end
	local ok, cg = pcall(function()
		return game:GetService("CoreGui")
	end)
	if ok and cg then
		return cg
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local guiParent = getGuiParent()

local function protect(gui)
	if syn and syn.protect_gui then
		pcall(syn.protect_gui, gui)
	end
	if protect_gui then
		pcall(protect_gui, gui)
	end
end

local screen = Instance.new("ScreenGui")
screen.Name = "\0"
screen.ResetOnSpawn = false
screen.IgnoreGuiInset = true
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
protect(screen)
screen.Parent = guiParent

