--!nocheck
-- [[ d4vid ELITE V25: MAX VELOCITY HUB (PERSISTENT & MOBILE) ]]
-- Velocity-predicted, buttery-smooth FOV aimbot hub.
--   * true velocity/lead prediction  -> tracks moving targets, no miss
--   * frame-rate independent smoothing -> consistent feel on any FPS / ping
--   * sticky target                   -> locks one target cleanly, no jitter
--   * selectable hit part, team / wall check, FOV up to 1000
--   * scrollable mobile hub, floating toggle, auto-saving config

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

-- ============================================================
-- CONFIG & PERSISTENCE
-- ============================================================
local ConfigFile = "d4vid_v26_config.json"

-- Defaults tuned for Rivals (hitscan, team based):
--   * prediction OFF  -> crosshair sits ON the head, not ahead of it
--   * sticky keeps following the locked player even outside the FOV circle
local Settings = {
	MasterEnabled    = true,
	Aimbot           = true,
	TeamCheck        = true,
	WallCheck        = true,
	Prediction       = false,  -- Rivals is hitscan: leading misses the head
	Smoothing        = true,
	StickyTarget     = true,
	StickyIgnoreFOV  = true,    -- keep tracking a locked target off-circle
	RainbowUI        = true,
	ShowFOV          = true,
	Fov              = 150,     -- circle radius (px), 50 .. 1000
	Strength         = 0.96,    -- smoothing / snap, 0.05 .. 1.0 (1 = instant)
	PredictionAmount = 0.16,    -- seconds of lead, 0 .. 1 (only if Prediction on)
	TargetPart       = "Head",  -- Head / Torso / HumanoidRootPart
}

local PART_OPTIONS = { "Head", "Torso", "HumanoidRootPart" }

-- Seconds a lock is held through brief off-screen / wall / dodge losses
-- before it is allowed to switch to another target.
local LOCK_GRACE = 0.45

-- Once the crosshair is within this angle of the target, the lock snaps
-- fully (hard-lock on the head) instead of continuing to ease in. A wider
-- angle = stiffer feel (clamps onto the target from farther out).
local HARD_LOCK_ANGLE = math.rad(3.6)

local function LoadSettings()
	if isfile and readfile and isfile(ConfigFile) then
		pcall(function()
			local decoded = HttpService:JSONDecode(readfile(ConfigFile))
			if type(decoded) == "table" then
				for k, v in pairs(decoded) do
					-- Only accept a saved value when it matches the type of the
					-- default. A corrupt or old-schema config (e.g. a number
					-- stored as a string) can otherwise break the UI builders.
					if Settings[k] ~= nil and type(v) == type(Settings[k]) then
						Settings[k] = v
					end
				end
			end
		end)
	end
end

local function SaveSettings()
	if writefile then
		pcall(function()
			writefile(ConfigFile, HttpService:JSONEncode(Settings))
		end)
	end
end

LoadSettings()

