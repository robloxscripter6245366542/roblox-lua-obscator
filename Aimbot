genv.__d4vidCleanup = function()
	for _, c in ipairs(conns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(conns)
	if sg then pcall(function() sg:Destroy() end) end
	genv.__d4vidCleanup = nil
end
-- keep legacy handle working too
genv.EliteLock = { Disconnect = genv.__d4vidCleanup }
