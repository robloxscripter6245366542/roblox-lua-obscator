local circleStroke = Instance.new("UIStroke")
circleStroke.Thickness = 2
circleStroke.Color = Color3.fromRGB(120, 200, 255)
circleStroke.Transparency = 0.15
circleStroke.Parent = circle

local function refreshCircle()
	circle.Size = UDim2.new(0, state.fov * 2, 0, state.fov * 2)
	circle.Visible = state.enabled
end

