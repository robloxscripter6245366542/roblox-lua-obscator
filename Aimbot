-- ============================================================
-- UI behaviour
-- ============================================================
local function applyToggleStyle()
	if state.enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(60, 200, 120)
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(40, 44, 58)
	end
end

local function setEnabled(on)
	state.enabled = on and true or false
	applyToggleStyle()
	refreshCircle()
end

local function setFov(value)
	state.fov = math.clamp(math.floor(value + 0.5), FOV_MIN, FOV_MAX)
	fovLabel.Text = "FOV: " .. state.fov
	fill.Size = UDim2.new((state.fov - FOV_MIN) / (FOV_MAX - FOV_MIN), 0, 1, 0)
	refreshCircle()
end

track(toggle.MouseButton1Click:Connect(function()
	setEnabled(not state.enabled)
end))

-- Slider dragging (mouse + touch)
local sliderDragging = false
local function setFovFromX(x)
	local rel = math.clamp((x - sliderBar.AbsolutePosition.X) / math.max(sliderBar.AbsoluteSize.X, 1), 0, 1)
	setFov(FOV_MIN + rel * (FOV_MAX - FOV_MIN))
end

track(sliderBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliderDragging = true
		setFovFromX(input.Position.X)
	end
end))
track(UserInputService.InputChanged:Connect(function(input)
	if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		setFovFromX(input.Position.X)
	end
end))
track(UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliderDragging = false
	end
end))

-- Panel dragging via the title (mouse + touch)
do
	local dragging = false
	local dragStart, startPos
	track(title.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = panel.Position
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			panel.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end

-- ============================================================
-- Targeting
-- ============================================================
local function isFriendly(player)
	if not state.teamCheck then
		return false
	end
	local myTeam = LocalPlayer.Team
	if myTeam == nil then
		return false -- FFA game: everyone is a target
	end
	return player.Team ~= nil and player.Team == myTeam
end

local function getAimPart(character)
	return character:FindFirstChild("Head")
		or character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
end

-- Returns the aim part of the target closest to the screen centre that
-- sits inside the FOV circle. This is how "everyone in the circle" is
-- handled: the closest in-circle target is picked every frame, so the
-- lock automatically switches between however many targets are present.
local function getClosestInFOV()
	local viewport = Camera.ViewportSize
	local centre = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
	local bestPart = nil
	local bestDist = state.fov

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and not isFriendly(player) then
			local character = player.Character
			if character then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local part = getAimPart(character)
				if humanoid and humanoid.Health > 0 and part then
					local screenPoint, onScreen = Camera:WorldToViewportPoint(part.Position)
					if onScreen then
						local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - centre).Magnitude
						if dist <= state.fov and dist < bestDist then
							bestDist = dist
							bestPart = part
						end
					end
				end
			end
		end
	end
	return bestPart
end

-- ============================================================
-- Aim loop
-- ============================================================
track(RunService.RenderStepped:Connect(function()
	Camera = workspace.CurrentCamera or Camera
	if not state.enabled or not Camera then
		return
	end
	local part = getClosestInFOV()
	if part then
		local goal = CFrame.new(Camera.CFrame.Position, part.Position)
		if state.smooth >= 1 then
			Camera.CFrame = goal
		else
			Camera.CFrame = Camera.CFrame:Lerp(goal, math.clamp(state.smooth, 0.05, 1))
		end
	end
end))

-- ============================================================
-- Cleanup handle
-- ============================================================
genv.__ipadFovCleanup = function()
	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(conns)
	if screen then
		pcall(function()
			screen:Destroy()
		end)
	end
	genv.__ipadFovCleanup = nil
end

applyToggleStyle()
setFov(state.fov)
