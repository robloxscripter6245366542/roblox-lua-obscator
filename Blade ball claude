    local text = Instance.new('TextLabel')
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = ""
    text.Font = Enum.Font.GothamBold
    text.TextSize = 24
    text.TextColor3 = Color3.fromRGB(255, 255, 255)
    text.ZIndex = 10001
    text.Parent = button
    
    local __ui_open = true
    button.MouseButton1Click:Connect(function()
        __ui_open = not __ui_open
        local toggled = pcall(function()
            if __ui_open then
                if Window.Open then Window:Open() elseif Window.Maximize then Window:Maximize() end
            else
                if Window.Close then Window:Close() elseif Window.Minimize then Window:Minimize() end
            end
        end)
        if not toggled then
            pcall(function() Window:Toggle() end)
        end
    end)
    
    button.Parent = gui
    gui.Parent = CoreGui
    mobile_ui_button = {gui = gui, button = button}
    return mobile_ui_button
end

if System.__properties.__is_mobile then
    task.spawn(function() task.wait(2); create_mobile_ui_button() end)
end

