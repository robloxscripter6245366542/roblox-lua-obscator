local function toggleAutoParryHotkey()
    local ns = not System.__properties.__autoparry_enabled
    System.__properties.__autoparry_enabled = ns
    System.__properties.__play_animation = ns
    if ns then System.autoparry.start() else System.autoparry.stop() end
    WindUI:Notify({Title = "Auto Parry", Content = ns and "ON" or "OFF", Duration = 1})
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end

    local kc = input.KeyCode

    if kc == spamKeyCode then
        System.__properties.__manual_spam_enabled = not System.__properties.__manual_spam_enabled
        macroSpamActive = System.__properties.__manual_spam_enabled
        if macroSpamActive then System.manual_spam.start() else System.manual_spam.stop() end
        if g.ManualSpamNotify then
            WindUI:Notify({Title = "Manual Spam", Content = macroSpamActive and "ON" or "OFF", Duration = 1})
        end
    end

    if kc == trigKeyCode then
        local ns = not System.__properties.__triggerbot_enabled
        System.__properties.__triggerbot_enabled = ns
        System.triggerbot.enable(ns)
        if g.TriggerbotNotify then
            WindUI:Notify({Title = "Triggerbot", Content = ns and "ON" or "OFF", Duration = 1})
        end
    end

    if kc == apKeyCode and g.AutoParryKeybindEnabled then
        toggleAutoParryHotkey()
    end
end)

