local function esp_ensure_highlight(adornee, color)
    local hl = ESP.highlights[adornee]
    if not hl or not hl.Parent then
        hl = Instance.new('Highlight')
        hl.FillColor = color
        hl.FillTransparency = 0.55
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0.35
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = adornee
        hl.Parent = ESP_HOLDER
        ESP.highlights[adornee] = hl
    end
    hl.FillColor = color
    return hl
end

local function esp_ensure_billboard(char)
    local head = char:FindFirstChild('Head') or char:FindFirstChild('HumanoidRootPart')
    if not head then return nil end
    local bb = ESP.billboards[char]
    if not bb or not bb.Parent then
        bb = Instance.new('BillboardGui')
        bb.Name = 'EagleESPTag'
        bb.Size = UDim2.new(0, 200, 0, 34)
        bb.StudsOffset = Vector3.new(0, 3.4, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = head
        bb.Parent = ESP_HOLDER
        local lbl = Instance.new('TextLabel')
        lbl.Name = 'Info'
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.TextStrokeTransparency = 0.4
        lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        lbl.Parent = bb
        ESP.billboards[char] = bb
    end
    return ESP.billboards[char]
end

local function esp_update()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild('HumanoidRootPart')

    -- Players
    local seen = {}
    if ESP.players_enabled and Alive then
        for _, char in ipairs(Alive:GetChildren()) do
            if char ~= myChar and char:FindFirstChild('Humanoid') and char:FindFirstChild('HumanoidRootPart') then
                seen[char] = true
                esp_ensure_highlight(char, ESP.player_color)
                local bb = esp_ensure_billboard(char)
                if bb then
                    local lbl = bb:FindFirstChild('Info')
                    if lbl then
                        local dist = myRoot and math.floor((myRoot.Position - char.HumanoidRootPart.Position).Magnitude) or 0
                        local hum = char:FindFirstChildOfClass('Humanoid')
                        local hp = hum and math.floor(hum.Health) or 0
                        lbl.Text = string.format('%s  [%dm]  HP:%d', char.Name, dist, hp)
                    end
                end
            end
        end
    end

    -- Balls
    local balls = workspace:FindFirstChild('Balls')
    if ESP.ball_enabled and balls then
        for _, ball in ipairs(balls:GetChildren()) do
            if ball:GetAttribute('realBall') then
                seen[ball] = true
                local target = ball:GetAttribute('target')
                local col = (target == LocalPlayer.Name) and Color3.fromRGB(255, 0, 0) or ESP.ball_color
                esp_ensure_highlight(ball, col)
            end
        end
    end

    -- Cleanup stale / disabled adornments
    for adornee, hl in pairs(ESP.highlights) do
        if not seen[adornee] or not adornee.Parent then
            pcall(function() hl:Destroy() end)
            ESP.highlights[adornee] = nil
        end
    end
    for char, bb in pairs(ESP.billboards) do
        if not seen[char] or not char.Parent then
            pcall(function() bb:Destroy() end)
            ESP.billboards[char] = nil
        end
    end
end

local function esp_set_running(state)
    if state then
        if not ESP.conn then
            ESP.conn = RunService.RenderStepped:Connect(esp_update)
        end
    else
        if not ESP.players_enabled and not ESP.ball_enabled then
            if ESP.conn then ESP.conn:Disconnect(); ESP.conn = nil end
            esp_clear_all()
        end
    end
end

