-- ========== SMOOTHED LATENCY (for predictive parry) ==========
-- Exponentially smooths Data Ping so a single jittery reading can't make the
-- predictor over-lead, and reports transient spikes so we can be conservative.
local __ping_state = { smooth = 0 }
local function get_latency()
    local ok, ms = pcall(function() return Stats.Network.ServerStatsItem['Data Ping']:GetValue() end)
    ms = (ok and ms) or 0
    if __ping_state.smooth <= 0 then __ping_state.smooth = ms end
    __ping_state.smooth = __ping_state.smooth + (ms - __ping_state.smooth) * 0.25
    local spike = ms > (__ping_state.smooth * 1.8) and (ms - __ping_state.smooth) > 60
    local lead_ms
    if System.__properties.__ping_spike_guard then
        -- Use the calmer of raw vs smoothed for the lead so spikes never over-fire.
        lead_ms = spike and __ping_state.smooth or math.min(ms, __ping_state.smooth * 1.3)
    else
        lead_ms = ms
    end
    return ms / 1000, lead_ms / 1000, spike
end

