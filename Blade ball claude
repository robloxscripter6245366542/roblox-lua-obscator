local function getSlashName(swordName)
    local s = swordInstances:GetSword(swordName)
    return (s and s.SlashName) or "SlashEffect"
end

local function refreshSlashName()
    local fn = g.swordFX ~= "" and g.swordFX or g.swordModel
    g.slashName = fn ~= "" and getSlashName(fn) or "SlashEffect"
end

local function setSword()
    if not g.skinChangerEnabled or not LocalPlayer.Character then return end
    pcall(function()
        local f = rawget(swordInstances, "EquipSwordTo")
        if type(f) == "function" then
            local ok, ups = pcall(function() return getupvalues(f) end)
            if ok then
                for i = 1, #ups do 
                    if type(ups[i]) == "boolean" then 
                        pcall(function() setupvalue(f, i, false) end)
                        break 
                    end 
                end
            end
        end
    end)
    
    if g.changeSwordModel and g.swordModel ~= "" then
        pcall(function() swordInstances:EquipSwordTo(LocalPlayer.Character, g.swordModel) end)
    end
    
    task.spawn(function()
        local att = 0
        while not swordsController and att < 20 do 
            task.wait(0.5)
            att = att + 1 
        end
        if not swordsController then return end
        
        if g.changeSwordAnimation then
            pcall(function()
                if swordsController.SetSword then
                    swordsController:SetSword(g.swordAnimations ~= "" and g.swordAnimations or g.swordModel)
                end
            end)
        end
        
        pcall(function()
            refreshSlashName()
            if swordsController.currentSword ~= nil then
                pcall(function() swordsController.currentSword = g.swordFX ~= "" and g.swordFX or g.swordModel end)
            end
            if swordsController.SwordFX ~= nil then
                pcall(function() swordsController.SwordFX = g.swordFX ~= "" and g.swordFX or g.swordModel end)
            end
        end)
    end)
end

