local hookedFuncs = {}
task.spawn(function()
    while task.wait(1) do
        local ok, conns = pcall(function() return getconnections(ReplicatedStorage.Remotes.ParrySuccessAll.OnClientEvent) end)
        if ok and type(conns) == "table" then
            for _, v in ipairs(conns) do
                local func = v.Function
                if func and not hookedFuncs[func] then
                    local is_our_closure = isourclosure or islclosure
                    if is_our_closure and is_our_closure(func) then 
                        hookedFuncs[func] = true
                        continue 
                    end
                    
                    hookedFuncs[func] = true
                    pcall(function() v:Disable() end)
                    
                    local tf = func
                    local of
                    of = function(...)
                        local args = {...}
                        if tostring(args[4]) == LocalPlayer.Name and g.skinChangerEnabled then
                            refreshSlashName()
                            args[1] = g.slashName
                            args[3] = g.swordFX ~= "" and g.swordFX or g.swordModel
                        end
                        local setthread = setthreadidentity or setidentity
                        if setthread then pcall(setthread, 2) end
                        pcall(tf, unpack(args))
                    end
                    hookedFuncs[of] = true
                    ReplicatedStorage.Remotes.ParrySuccessAll.OnClientEvent:Connect(of)
                end
            end
        end
    end
end)

