-- ========== REJOIN / SERVER HOP ==========
local function rejoin_server()
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end)
end

local function server_hop()
    local ok, body = pcall(function()
        local url = 'https://games.roblox.com/v1/games/' .. tostring(game.PlaceId)
            .. '/servers/Public?sortOrder=Asc&limit=100'
        return game:HttpGet(url)
    end)
    if ok and body then
        local decoded
        local ok2 = pcall(function() decoded = HttpService:JSONDecode(body) end)
        if ok2 and decoded and decoded.data then
            local candidates = {}
            for _, s in ipairs(decoded.data) do
                if type(s) == 'table' and s.id and s.id ~= game.JobId
                    and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
                    table.insert(candidates, s)
                end
            end
            if #candidates > 0 then
                local pick = candidates[math.random(1, #candidates)]
                local teleported = pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, LocalPlayer)
                end)
                if teleported then return true end
            end
        end
    end
    -- Fallback: plain rejoin
    rejoin_server()
    return false
end

-- ========== CONFIG SAVE / LOAD ==========
local CONFIG_FILE = 'EagleHubX_Config.json'

local function collect_config()
    return {
        AutoParryMode = g.AutoParryMode,
        Accuracy = System.__properties.__accuracy,
        CurveMode = System.__properties.__curve_mode,
        RandomizedAccuracy = System.__properties.__randomized_accuracy_enabled,
        CooldownProtection = g.CooldownProtection,
        AutoAbility = g.AutoAbility,
        ManualSpamMode = g.ManualSpamMode,
        AutoSpamMode = g.AutoSpamMode,
        SpamThreshold = System.__properties.__spam_threshold,
        AutoSpamDistanceMultiplier = System.__properties.__auto_spam_distance_multiplier,
        CameraFOV = g.CameraFOV,
        Detections = {
            infinity = System.__config.__detections.__infinity,
            deathslash = System.__config.__detections.__deathslash,
            timehole = System.__config.__detections.__timehole,
            slashesoffury = System.__config.__detections.__slashesoffury,
            phantom = System.__config.__detections.__phantom,
        },
    }
end

local function apply_config(cfg)
    if type(cfg) ~= 'table' then return end
    if cfg.AutoParryMode then g.AutoParryMode = cfg.AutoParryMode end
    if cfg.Accuracy then System.__properties.__accuracy = cfg.Accuracy; update_divisor() end
    if cfg.CurveMode then System.__properties.__curve_mode = cfg.CurveMode end
    if cfg.RandomizedAccuracy ~= nil then System.__properties.__randomized_accuracy_enabled = cfg.RandomizedAccuracy end
    if cfg.CooldownProtection ~= nil then g.CooldownProtection = cfg.CooldownProtection end
    if cfg.AutoAbility ~= nil then g.AutoAbility = cfg.AutoAbility end
    if cfg.ManualSpamMode then g.ManualSpamMode = cfg.ManualSpamMode end
    if cfg.AutoSpamMode then g.AutoSpamMode = cfg.AutoSpamMode end
    if cfg.SpamThreshold then System.__properties.__spam_threshold = cfg.SpamThreshold end
    if cfg.AutoSpamDistanceMultiplier then System.__properties.__auto_spam_distance_multiplier = cfg.AutoSpamDistanceMultiplier end
    if cfg.CameraFOV then g.CameraFOV = cfg.CameraFOV end
    if type(cfg.Detections) == 'table' then
        local d = cfg.Detections
        System.__config.__detections.__infinity = d.infinity or false
        System.__config.__detections.__deathslash = d.deathslash or false
        System.__config.__detections.__timehole = d.timehole or false
        System.__config.__detections.__slashesoffury = d.slashesoffury or false
        System.__config.__detections.__phantom = d.phantom or false
    end
end

local function save_config()
    if not writefile then return false, 'writefile not supported by executor' end
    local ok, enc = pcall(function() return HttpService:JSONEncode(collect_config()) end)
    if not ok then return false, 'encode failed' end
    local wrote = pcall(writefile, CONFIG_FILE, enc)
    return wrote, wrote and 'saved' or 'write failed'
end

local function load_config()
    if not (readfile and isfile) then return false, 'readfile not supported by executor' end
    if not isfile(CONFIG_FILE) then return false, 'no saved config' end
    local ok, data = pcall(readfile, CONFIG_FILE)
    if not ok then return false, 'read failed' end
    local decoded
    local ok2 = pcall(function() decoded = HttpService:JSONDecode(data) end)
    if not ok2 then return false, 'decode failed' end
    apply_config(decoded)
    return true, 'loaded (logic applied; re-toggle UI elements to see values)'
end

