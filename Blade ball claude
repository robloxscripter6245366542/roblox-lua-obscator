-- ---------- ESP System (Ball / Player / Threat) ----------
local ESP = {balls = {}, players = {}, threat = {hl = nil, target = nil}, renderConn = nil, removingConn = nil}

local function ESP_newHighlight(adornee, fill, outline, fillT)
    local h = Instance.new("Highlight")
    h.FillColor = fill
    h.OutlineColor = outline
    h.FillTransparency = fillT or 0.5
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee = adornee
    h.Parent = adornee
    return h
end

local function ESP_clearBalls()
    for ball, h in pairs(ESP.balls) do pcall(function() h:Destroy() end) end
    ESP.balls = {}
end

local function ESP_clearThreat()
    if ESP.threat.hl then pcall(function() ESP.threat.hl:Destroy() end) end
    ESP.threat.hl = nil
    ESP.threat.target = nil
end

local function ESP_removePlayer(plr)
    local d = ESP.players[plr]
    if d then
        if d.highlight then pcall(function() d.highlight:Destroy() end) end
        if d.bb then pcall(function() d.bb:Destroy() end) end
        ESP.players[plr] = nil
    end
end

local function ESP_clearPlayers()
    for plr in pairs(ESP.players) do ESP_removePlayer(plr) end
end

local function ESP_setupPlayer(plr)
    if plr == LocalPlayer or ESP.players[plr] then return end
    local char = plr.Character
    if not char then return end
    local head = char:FindFirstChild("Head") or char:FindFirstChildWhichIsA("BasePart")
    if not head then return end

    local hl = ESP_newHighlight(char, Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 255, 255), 0.65)

    local bb = Instance.new("BillboardGui")
    bb.Name = "EagleESP_BB"
    bb.Adornee = head
    bb.Size = UDim2.new(0, 220, 0, 20)
    bb.StudsOffset = Vector3.new(0, 2.6, 0)
    bb.AlwaysOnTop = true

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0.4
    label.Parent = bb
    bb.Parent = head

    ESP.players[plr] = {highlight = hl, bb = bb, label = label, char = char}
end

local function ESP_render()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    -- Ball ESP
    if g.BallESP then
        local balls = System.ball.get_all()
        local seen = {}
        for _, ball in ipairs(balls) do
            seen[ball] = true
            if not ESP.balls[ball] then
                ESP.balls[ball] = ESP_newHighlight(ball, Color3.fromRGB(0, 200, 255), Color3.fromRGB(255, 255, 255), 0.3)
            end
        end
        for ball, h in pairs(ESP.balls) do
            if not seen[ball] or not ball.Parent then
                pcall(function() h:Destroy() end)
                ESP.balls[ball] = nil
            end
        end
    elseif next(ESP.balls) then
        ESP_clearBalls()
    end

    -- Player ESP
    if g.PlayerESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                local d = ESP.players[plr]
                if d and d.char ~= plr.Character then ESP_removePlayer(plr); d = nil end
                if not d then ESP_setupPlayer(plr) end
            end
        end
        for plr, d in pairs(ESP.players) do
            if not plr.Parent or not plr.Character or not plr.Character.Parent then
                ESP_removePlayer(plr)
            elseif d.label then
                local dist = 0
                local prroot = plr.Character:FindFirstChild("HumanoidRootPart")
                if root and prroot then dist = math.floor((root.Position - prroot.Position).Magnitude) end
                d.label.Text = string.format("%s [%dm]", plr.DisplayName, dist)
            end
        end
    elseif next(ESP.players) then
        ESP_clearPlayers()
    end

    -- Threat highlight (whoever the ball currently targets)
    if g.TargetHighlight then
        local ball = System.ball.get()
        local targetName = ball and ball:GetAttribute("target")
        local targetChar = (targetName and Alive) and Alive:FindFirstChild(targetName) or nil
        if targetChar ~= ESP.threat.target then
            ESP_clearThreat()
            if targetChar then
                ESP.threat.hl = ESP_newHighlight(targetChar, Color3.fromRGB(255, 200, 0), Color3.fromRGB(255, 0, 0), 0.4)
                ESP.threat.target = targetChar
            end
        end
    elseif ESP.threat.hl then
        ESP_clearThreat()
    end
end

local function ESP_updateState()
    if g.BallESP or g.PlayerESP or g.TargetHighlight then
        if not ESP.renderConn then
            ESP.renderConn = RunService.RenderStepped:Connect(function() pcall(ESP_render) end)
        end
        if not ESP.removingConn then
            ESP.removingConn = Players.PlayerRemoving:Connect(function(plr) ESP_removePlayer(plr) end)
        end
    else
        if ESP.renderConn then ESP.renderConn:Disconnect(); ESP.renderConn = nil end
        if ESP.removingConn then ESP.removingConn:Disconnect(); ESP.removingConn = nil end
        ESP_clearBalls(); ESP_clearPlayers(); ESP_clearThreat()
    end
end

