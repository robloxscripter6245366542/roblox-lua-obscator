    ping = ok and ping or 0
    local elapsed = tick() - Stats_Session.session_start
    local mins = math.floor(elapsed / 60)
    local secs = math.floor(elapsed % 60)
    local ball = System.ball.get()
    local speed = 0
    if ball then
        local z = ball:FindFirstChild('zoomies')
        if z then speed = z.VectorVelocity.Magnitude end
    end
    StatsHUD.label.Text = string.format(
        '<b><font color="#00aaff">EAGLE HUB X</font></b>\nParries: %d\nBall Speed: %.0f\nPing: %d ms\nFPS: %d\nTime: %02d:%02d',
        Stats_Session.parries, speed, ping, Stats_Session.fps, mins, secs)
end

local function stats_hud_set(state)
    StatsHUD.enabled = state
    if state then
        stats_hud_build()
        if not StatsHUD.conn then
            StatsHUD.conn = RunService.RenderStepped:Connect(stats_hud_update)
        end
    else
        if StatsHUD.conn then StatsHUD.conn:Disconnect(); StatsHUD.conn = nil end
        if StatsHUD.gui then StatsHUD.gui:Destroy(); StatsHUD.gui = nil; StatsHUD.label = nil end
    end
end

