# Copy to .env and fill in, or export these directly in your process manager.

DISCORD_BOT_TOKEN=

# Optional tuning (defaults shown):
# LURAPH_DEOBF_DIR=..            # path to the luraph-deobf/ toolkit
# MAX_UPLOAD_BYTES=3145728       # 3 MB max input script size
# MAX_ATTACH_BYTES=8388608       # 8 MB max per output file attached back
# JOB_TIMEOUT_SECONDS=240        # hard wall-clock cap per /deobfuscate run
# MAX_CONCURRENT_JOBS=2          # how many pipeline runs may execute at once
# COOLDOWN_SECONDS=60            # per-user cooldown between /deobfuscate calls
