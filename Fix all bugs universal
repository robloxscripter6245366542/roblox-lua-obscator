local rng = Random.new()
local function CalculateChance(percentage)
    percentage = math.clamp(math.floor(tonumber(percentage) or 0), 0, 100)
    if percentage >= 100 then return true end
    if percentage <= 0 then return false end
    return (rng:NextNumber(0, 1) * 100) <= percentage
end

local function getMousePosition()
    return UserInputService:GetMouseLocation()
end

local function getViewportCenter()
    local v = Camera.ViewportSize
    return Vector2.new(v.X / 2, v.Y / 2)
end

-- WorldToScreenPoint accounts for the GUI inset (matches GetMouseLocation).
local function worldToScreen(worldVector)
    local screen, onScreen = Camera:WorldToScreenPoint(worldVector)
    return Vector2.new(screen.X, screen.Y), onScreen, screen.Z
end

local function getPing()
    if not Stats then return 0 end
    local ok, ms = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and type(ms) == "number" then return ms / 1000 end -- seconds
    return 0
end

local function isWhitelisted(name)
    for _, n in ipairs(Config.Whitelist) do
        if n == name then return true end
    end
    return false
end

local function resolveTargetPart(character)
    if Config.TargetPart == "Random" then
        return character:FindFirstChild(ValidTargetParts[math.random(1, #ValidTargetParts)])
    end
    return character:FindFirstChild(Config.TargetPart)
        or character:FindFirstChild("HumanoidRootPart")
end

-- Lead a moving part by its velocity (+ optional ping compensation).
local function getAimPosition(part)
    if not Config.Prediction then return part.Position end
    local lead = Config.PredictionAmount
    if Config.PingCompensation then lead = lead + getPing() end
    return part.Position + (part.AssemblyLinearVelocity * lead)
end

local function getDirectionTo(origin, part)
    return (getAimPosition(part) - origin).Unit * 1000
end

local function ValidateArguments(Args, RayMethod)
    if #Args < RayMethod.ArgCountRequired then return false end
    local matches = 0
    for pos, argument in ipairs(Args) do
        if typeof(argument) == RayMethod.Args[pos] then
            matches = matches + 1
        end
    end
    return matches >= RayMethod.ArgCountRequired
end

local function isVisible(playerCharacter, localCharacter)
    if not (playerCharacter and localCharacter) then return false end
    local root = playerCharacter:FindFirstChild("HumanoidRootPart")
        or playerCharacter:FindFirstChild("Head")
    if not root then return false end
    local ok, obscuring = pcall(function()
        return Camera:GetPartsObscuringTarget({ root.Position }, { localCharacter, playerCharacter })
    end)
    if not ok then return true end
    return #obscuring == 0
end

-- ═══════════════════════════════════════════════════════════════════
--  TARGET ACQUISITION
-- ═══════════════════════════════════════════════════════════════════
-- Returns the Player passing every filter; scoring depends on TargetMode.
local function acquireTarget()
    local localCharacter = LocalPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    local anchor = (Config.TargetMode == "Screen Center") and getViewportCenter() or getMousePosition()

    -- Sticky: keep the current target while it stays valid.
    if Config.StickyTarget and Runtime.currentPlayer then
        local p = Runtime.currentPlayer
        local char = p.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if p.Parent and char and hum and hrp and hum.Health > 0 then
            local sp, onScreen = worldToScreen(hrp.Position)
            local stillClose = true
            if Config.TargetMode == "Cursor FOV" or Config.TargetMode == "Screen Center" then
                stillClose = onScreen and (anchor - sp).Magnitude <= Config.FOVRadius
            elseif Config.MaxDistance > 0 and localRoot then
                stillClose = (localRoot.Position - hrp.Position).Magnitude <= Config.MaxDistance
            end
            if stillClose then
                return p
            end
        end
    end

    local best, bestScore
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if isWhitelisted(player.Name) then continue end
        if Config.TeamCheck and player.Team == LocalPlayer.Team then continue end

        local character = player.Character
        if not character then continue end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not hrp or humanoid.Health <= 0 then continue end

        if Config.MaxDistance > 0 and localRoot
        and (localRoot.Position - hrp.Position).Magnitude > Config.MaxDistance then continue end

        if Config.VisibleCheck and not isVisible(character, localCharacter) then continue end

        local screenPos, onScreen = worldToScreen(hrp.Position)

        local score
        if Config.TargetMode == "Closest Distance" then
            if not localRoot then continue end
            score = (localRoot.Position - hrp.Position).Magnitude
        elseif Config.TargetMode == "Lowest Health" then
            score = humanoid.Health
        else -- Cursor FOV / Screen Center
            if not onScreen then continue end
            local d = (anchor - screenPos).Magnitude
            if d > Config.FOVRadius then continue end
            score = d
        end

        if score and (not bestScore or score < bestScore) then
            best, bestScore = player, score
        end
    end
    return best
end

-- ═══════════════════════════════════════════════════════════════════
--  CONFIG FILE HANDLING  (guarded)
-- ═══════════════════════════════════════════════════════════════════
local canUseFiles = (isfolder and makefolder and writefile and readfile and listfiles and isfile) and true or false

local function placeFolder()
    return string.format("%s/%s", MainFileName, tostring(game.PlaceId))
end

if canUseFiles then
    pcall(function()
        if not isfolder(MainFileName) then makefolder(MainFileName) end
        if not isfolder(placeFolder()) then makefolder(placeFolder()) end
    end)
end

local function GetFiles()
    local out = {}
    if not canUseFiles then return out end
    local ok, files = pcall(listfiles, placeFolder())
    if not ok or type(files) ~= "table" then return out end
    for _, file in ipairs(files) do
        if file:sub(-4) == ".lua" then
            local name = file:gsub("\\", "/"):match("([^/]+)%.lua$")
            if name then table.insert(out, name) end
        end
    end
    return out
end

-- JSON can't hold Color3 (userdata); convert to a tagged table and back,
-- and drop anything not JSON-safe.
local function sanitize(t)
    local out = {}
    for k, v in pairs(t) do
        local ty = typeof(v)
        if ty == "Color3" then
            out[k] = { __c3 = true, R = v.R, G = v.G, B = v.B }
        elseif ty == "table" then
            out[k] = sanitize(v)
        elseif ty == "number" or ty == "string" or ty == "boolean" then
            out[k] = v
        end
    end
    return out
end

local function restore(dst, src)
    for k, v in pairs(src) do
        if type(v) == "table" and v.__c3 then
            if dst[k] ~= nil then dst[k] = Color3.new(v.R, v.G, v.B) end
        elseif type(v) == "table" then
            dst[k] = v          -- arrays like Whitelist
        elseif dst[k] ~= nil then
            dst[k] = v
        end
    end
end

local function UpdateFile(fileName)
    assert(type(fileName) == "string" and fileName ~= "", "invalid config name")
    if not canUseFiles then return end
    writefile(string.format("%s/%s.lua", placeFolder(), fileName), HttpService:JSONEncode(sanitize(Config)))
end

local function LoadFile(fileName)
    assert(type(fileName) == "string" and fileName ~= "", "invalid config name")
    if not canUseFiles then return end
    local path = string.format("%s/%s.lua", placeFolder(), fileName)
    if not isfile(path) then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if ok and type(data) == "table" then
        restore(Config, data)
    end
end

