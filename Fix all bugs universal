--  CONFIG FILE HANDLING  (guarded — thin executors may lack file API)
-- ═══════════════════════════════════════════════════════════════════
local canUseFiles = (isfolder and makefolder and writefile and readfile and listfiles and isfile) and true or false

local function placeFolder()
    return string.format("%s/%s", MainFileName, tostring(game.PlaceId))
end

if canUseFiles then
    pcall(function()
        if not isfolder(MainFileName) then makefolder(MainFileName) end
        if not isfolder(placeFolder()) then makefolder(placeFolder()) end
    end)
end

-- FIX #9: list files fresh on every call so new saves appear immediately.
local function GetFiles()
    local out = {}
    if not canUseFiles then return out end
    local ok, files = pcall(listfiles, placeFolder())
    if not ok or type(files) ~= "table" then return out end
    for _, file in ipairs(files) do
        if file:sub(-4) == ".lua" then
            -- strip the directory prefix; keep only the base name
            local name = file:gsub("\\", "/")
            name = name:match("([^/]+)%.lua$")
            if name then table.insert(out, name) end
        end
    end
    return out
end

-- FIX #3: real type checks (original: assert(FileName or FileName == "string")).
local function UpdateFile(fileName)
    assert(type(fileName) == "string" and fileName ~= "", "invalid config name")
    if not canUseFiles then return end
    writefile(string.format("%s/%s.lua", placeFolder(), fileName), HttpService:JSONEncode(Config))
end

local function LoadFile(fileName)
    assert(type(fileName) == "string" and fileName ~= "", "invalid config name")
    if not canUseFiles then return end
    local path = string.format("%s/%s.lua", placeFolder(), fileName)
    if not isfile(path) then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if ok and type(data) == "table" then
        for index, value in pairs(data) do
            if Config[index] ~= nil then
                Config[index] = value
            end
        end
    end
end

