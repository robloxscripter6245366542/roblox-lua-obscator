--  MOBILE FLOATING BUTTONS  (touch, no keyboard)
-- ═══════════════════════════════════════════════════════════════════
local mobileGui
do
    mobileGui = Instance.new("ScreenGui")
    mobileGui.Name           = "USA_MobileButtons"
    mobileGui.ResetOnSpawn   = false
    mobileGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    mobileGui.DisplayOrder    = 999
    pcall(function() protectgui(mobileGui) end)
    mobileGui.Parent = (gethui and gethui()) or LocalPlayer:WaitForChild("PlayerGui")

    local function makeButton(offsetY, onText, offText, onTap)
        local btn = Instance.new("TextButton")
        btn.Size             = UDim2.fromOffset(78, 78)
        btn.Position         = UDim2.new(1, -98, 0.5, offsetY)
        btn.BackgroundColor3  = Color3.fromRGB(40, 40, 40)
        btn.BackgroundTransparency = 0.15
        btn.AutoButtonColor  = false
        btn.Text             = ""
        btn.Parent           = mobileGui
        Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = Color3.fromRGB(54, 57, 241); stroke.Thickness = 2

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1); label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold; label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextSize = 14; label.Text = offText; label.Parent = btn
        label:SetAttribute("onText", onText); label:SetAttribute("offText", offText)

        local dragging, moved, dragStart, startPos
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging, moved = true, false
                dragStart, startPos = input.Position, btn.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement) then
                local delta = input.Position - dragStart
                if delta.Magnitude > 6 then moved = true end
                btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                         startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1) then
                dragging = false
                if not moved then onTap() end
            end
        end)
        return btn, label
    end

    ui.aimBtn, ui.aimLabel = makeButton(-88, "AIM: ON", "AIM: OFF", function() setEnabled(not Config.Enabled) end)
    ui.espBtn, ui.espLabel = makeButton(10,  "ESP: ON", "ESP: OFF", function()
        Config.ESPEnabled = not Config.ESPEnabled
        pcall(function() ui.espMaster:SetValue(Config.ESPEnabled) end)
        refreshFloat(ui.espBtn, ui.espLabel, Config.ESPEnabled)
        if not Config.ESPEnabled then for _, o in pairs(ESP) do hideEsp(o) end end
    end)
end

