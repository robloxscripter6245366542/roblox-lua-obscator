--  RENDER LOOP  (marker + FOV circle)
-- ═══════════════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    if not hasDrawing then return end

    if Config.ShowSilentAimTarget and Config.Enabled then
        -- FIX #6: resolve the target once per frame, not three times.
        local target = getClosestPlayer()
        if target then
            local root = (target.Parent and target.Parent.PrimaryPart) or target
            local viewport, onScreen = Camera:WorldToViewportPoint(root.Position)
            mouse_box.Visible  = onScreen
            mouse_box.Position = Vector2.new(viewport.X - mouse_box.Size.X / 2,
                                             viewport.Y - mouse_box.Size.Y / 2)
        else
            mouse_box.Visible  = false
        end
    elseif mouse_box.Visible then
        mouse_box.Visible = false
    end

    if Config.FOVVisible then
        fov_circle.Visible  = true
        fov_circle.Radius   = Config.FOVRadius
        fov_circle.Position = getMousePosition()
    elseif fov_circle.Visible then
        fov_circle.Visible = false
    end
end)

-- ═══════════════════════════════════════════════════════════════════
--  HOOKS  (__namecall for ray methods, __index for Mouse.Hit/Target)
-- ═══════════════════════════════════════════════════════════════════
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    local Method    = getnamecallmethod()
    local Arguments = { ... }
    local self      = Arguments[1]

    if Config.Enabled and self == Workspace and not checkcaller()
    and CalculateChance(Config.HitChance) then
        local wanted = Config.SilentAimMethod

        if Method == "FindPartOnRayWithIgnoreList" and wanted == Method then
            if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithIgnoreList) then
                local ray = Arguments[2]
                local hit = getClosestPlayer()
                if hit and typeof(ray) == "Ray" then
                    Arguments[2] = Ray.new(ray.Origin, getDirection(ray.Origin, hit.Position))
                    return oldNamecall(unpack(Arguments))
                end
            end
        elseif Method == "FindPartOnRayWithWhitelist" and wanted == Method then
            if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithWhitelist) then
                local ray = Arguments[2]
                local hit = getClosestPlayer()
                if hit and typeof(ray) == "Ray" then
                    Arguments[2] = Ray.new(ray.Origin, getDirection(ray.Origin, hit.Position))
                    return oldNamecall(unpack(Arguments))
                end
            end
        elseif (Method == "FindPartOnRay" or Method == "findPartOnRay")
        and wanted:lower() == Method:lower() then
            if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRay) then
                local ray = Arguments[2]
                local hit = getClosestPlayer()
                if hit and typeof(ray) == "Ray" then
                    Arguments[2] = Ray.new(ray.Origin, getDirection(ray.Origin, hit.Position))
                    return oldNamecall(unpack(Arguments))
                end
            end
        elseif Method == "Raycast" and wanted == Method then
            if ValidateArguments(Arguments, ExpectedArguments.Raycast) then
                local origin = Arguments[2]
                local hit = getClosestPlayer()
                if hit and typeof(origin) == "Vector3" then
                    Arguments[3] = getDirection(origin, hit.Position)
                    return oldNamecall(unpack(Arguments))
                end
            end
        end
    end

    return oldNamecall(...)
end))

local Mouse = LocalPlayer:GetMouse()

local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, Index)
    if self == Mouse and not checkcaller() and Config.Enabled
    and Config.SilentAimMethod == "Mouse.Hit/Target" then
        local hit = getClosestPlayer()
        if hit then
            if Index == "Target" or Index == "target" then
                return hit
            elseif Index == "Hit" or Index == "hit" then
                if Config.MouseHitPrediction then
                    return hit.CFrame + (hit.AssemblyLinearVelocity * Config.MouseHitPredictionAmount)
                end
                return hit.CFrame
            end
        end
    end
    return oldIndex(self, Index)
end))
