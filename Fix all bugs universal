-- ═══════════════════════════════════════════════════════════════════
--  MOBILE FLOATING BUTTONS  (AIM + LOCK) — touch, no keyboard
-- ═══════════════════════════════════════════════════════════════════
do
    local gui = Instance.new("ScreenGui")
    gui.Name           = "USA_MobileToggle"
    gui.ResetOnSpawn   = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder    = 999
    pcall(function() protectgui(gui) end)
    gui.Parent = (gethui and gethui()) or LocalPlayer:WaitForChild("PlayerGui")

    local function makeButton(offsetY, accent, offText, onTap)
        local btn = Instance.new("TextButton")
        btn.Size             = UDim2.fromOffset(82, 82)
        btn.Position         = UDim2.new(1, -102, 0.5, offsetY)
        btn.BackgroundColor3  = Color3.fromRGB(40, 40, 40)
        btn.BackgroundTransparency = 0.15
        btn.AutoButtonColor  = false
        btn.Text             = ""
        btn.Parent           = gui
        Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = accent; stroke.Thickness = 2

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1); label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold; label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextSize = 14; label.Text = offText; label.Parent = btn

        local dragging, moved, dragStart, startPos
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging, moved = true, false
                dragStart, startPos = input.Position, btn.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement) then
                local delta = input.Position - dragStart
                if delta.Magnitude > 6 then moved = true end
                btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                         startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1) then
                dragging = false
                if not moved then onTap() end
            end
        end)
        return btn, label
    end

    ui.aimBtn,  ui.aimLabel  = makeButton(-90, Color3.fromRGB(54, 57, 241), "AIM: OFF",
        function() setEnabled(not Config.Enabled) end)
    ui.lockBtn, ui.lockLabel = makeButton(8,   Color3.fromRGB(241, 78, 54), "LOCK: OFF",
        function() setCameraLock(not Config.CameraLock) end)
end

-- ═══════════════════════════════════════════════════════════════════
--  RENDER LOOP  (target cache + FOV + marker)
-- ═══════════════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    -- acquire the frame's target once (shared by hooks + camera lock + marker)
    if Config.Enabled or Config.CameraLock or Config.ShowTargetMarker then
        local player = acquireTarget()
        Runtime.currentPlayer = player
        Runtime.currentPart = player and player.Character and resolveTargetPart(player.Character) or nil
    else
        Runtime.currentPlayer, Runtime.currentPart = nil, nil
    end

    -- CAMERA LOCK (aimbot): glide the camera onto the target part.
    if Config.CameraLock and Runtime.currentPart then
        local cf = Camera.CFrame
        local goal = CFrame.new(cf.Position, getAimPosition(Runtime.currentPart))
        Camera.CFrame = cf:Lerp(goal, math.clamp(Config.AimbotSmoothness, 0.05, 1))
    end

    if not hasDrawing then return end

    if Config.FOVRainbow then
        Runtime.rainbowHue = (Runtime.rainbowHue + 0.005) % 1
    end

    -- FOV circle
    if Config.FOVVisible then
        fov_circle.Visible  = true
        fov_circle.Radius   = Config.FOVRadius
        fov_circle.NumSides = Config.FOVSides
        fov_circle.Filled   = Config.FOVFilled
        fov_circle.Color    = Config.FOVRainbow and Color3.fromHSV(Runtime.rainbowHue, 1, 1) or Config.FOVColor
        fov_circle.Position = Config.FOVFollowMouse and getMousePosition() or getViewportCenter()
    elseif fov_circle.Visible then
        fov_circle.Visible = false
    end

    -- target marker
    if Config.ShowTargetMarker and Config.Enabled and Runtime.currentPart then
        local sp, onScreen = worldToScreen(Runtime.currentPart.Position)
        mouse_box.Visible  = onScreen
        mouse_box.Color    = Config.FOVRainbow and Color3.fromHSV(Runtime.rainbowHue, 1, 1) or Config.FOVColor
        mouse_box.Position = Vector2.new(sp.X - mouse_box.Size.X / 2, sp.Y - mouse_box.Size.Y / 2)
    elseif mouse_box.Visible then
        mouse_box.Visible = false
    end
end)

-- ═══════════════════════════════════════════════════════════════════
--  HOOKS
-- ═══════════════════════════════════════════════════════════════════
if hasHooks then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
        local Method    = getnamecallmethod()
        local Arguments = { ... }
        local self      = Arguments[1]

        if Config.Enabled and self == Workspace and not checkcaller()
        and Runtime.currentPart and CalculateChance(Config.HitChance) then
            local wanted = Config.SilentAimMethod
            local part   = Runtime.currentPart

            if Method == "FindPartOnRayWithIgnoreList" and wanted == Method then
                if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithIgnoreList) then
                    local ray = Arguments[2]
                    if typeof(ray) == "Ray" then
                        Arguments[2] = Ray.new(ray.Origin, getDirectionTo(ray.Origin, part))
                        return oldNamecall(unpack(Arguments))
                    end
                end
            elseif Method == "FindPartOnRayWithWhitelist" and wanted == Method then
                if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithWhitelist) then
                    local ray = Arguments[2]
                    if typeof(ray) == "Ray" then
                        Arguments[2] = Ray.new(ray.Origin, getDirectionTo(ray.Origin, part))
                        return oldNamecall(unpack(Arguments))
                    end
                end
            elseif (Method == "FindPartOnRay" or Method == "findPartOnRay")
            and wanted:lower() == Method:lower() then
                if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRay) then
                    local ray = Arguments[2]
                    if typeof(ray) == "Ray" then
                        Arguments[2] = Ray.new(ray.Origin, getDirectionTo(ray.Origin, part))
                        return oldNamecall(unpack(Arguments))
                    end
                end
            elseif Method == "Raycast" and wanted == Method then
                if ValidateArguments(Arguments, ExpectedArguments.Raycast) then
                    local origin = Arguments[2]
                    if typeof(origin) == "Vector3" then
                        Arguments[3] = getDirectionTo(origin, part)
                        return oldNamecall(unpack(Arguments))
                    end
                end
            end
        end

        return oldNamecall(...)
    end))

    local Mouse = LocalPlayer:GetMouse()
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, Index)
        if self == Mouse and not checkcaller() and Config.Enabled
        and Config.SilentAimMethod == "Mouse.Hit/Target" and Runtime.currentPart then
            local part = Runtime.currentPart
            if Index == "Target" or Index == "target" then
                return part
            elseif Index == "Hit" or Index == "hit" then
                return CFrame.new(getAimPosition(part))
            end
        end
        return oldIndex(self, Index)
    end))
end
