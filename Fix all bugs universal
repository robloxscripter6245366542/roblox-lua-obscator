-- FIX #2: one reusable RNG, correct method call form.
local rng = Random.new()
local function CalculateChance(percentage)
    percentage = math.clamp(math.floor(tonumber(percentage) or 0), 0, 100)
    if percentage >= 100 then return true end
    if percentage <= 0 then return false end
    return (rng:NextNumber(0, 1) * 100) <= percentage
end

local function getMousePosition()
    return UserInputService:GetMouseLocation()
end

local function getPositionOnScreen(worldVector)
    -- WorldToScreenPoint accounts for the GUI inset (topbar), matching
    -- UserInputService:GetMouseLocation() so cursor-distance is accurate.
    local screen, onScreen = Camera:WorldToScreenPoint(worldVector)
    return Vector2.new(screen.X, screen.Y), onScreen
end

local function getDirection(origin, position)
    return (position - origin).Unit * 1000
end

local function ValidateArguments(Args, RayMethod)
    if #Args < RayMethod.ArgCountRequired then
        return false
    end
    local matches = 0
    for pos, argument in ipairs(Args) do
        if typeof(argument) == RayMethod.Args[pos] then
            matches = matches + 1
        end
    end
    return matches >= RayMethod.ArgCountRequired
end

local function IsPlayerVisible(playerCharacter, localCharacter)
    if not (playerCharacter and localCharacter) then return false end
    local root = playerCharacter:FindFirstChild(Config.TargetPart)
        or playerCharacter:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local ignore = { localCharacter, playerCharacter }
    local ok, obscuring = pcall(function()
        return Camera:GetPartsObscuringTarget({ root.Position }, ignore)
    end)
    if not ok then return true end
    return #obscuring == 0
end

-- Resolve the configured target part on a character (handles "Random").
local function resolveTargetPart(character)
    if Config.TargetPart == "Random" then
        return character:FindFirstChild(ValidTargetParts[math.random(1, #ValidTargetParts)])
    end
    return character:FindFirstChild(Config.TargetPart)
end

-- FIX #7: FOV radius is used purely as the selection cone; the closest
-- player *inside that cone* to the cursor is chosen.
local function getClosestPlayer()
    local mousePos = getMousePosition()
    local localCharacter = LocalPlayer.Character
    local closest, closestDist

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if Config.TeamCheck and player.Team == LocalPlayer.Team then continue end

        local character = player.Character
        if not character then continue end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not hrp or humanoid.Health <= 0 then continue end

        if Config.VisibleCheck and not IsPlayerVisible(character, localCharacter) then continue end

        local screenPos, onScreen = getPositionOnScreen(hrp.Position)
        if not onScreen then continue end

        local dist = (mousePos - screenPos).Magnitude
        if dist <= Config.FOVRadius and (not closestDist or dist < closestDist) then
            local part = resolveTargetPart(character)
            if part then
                closest, closestDist = part, dist
            end
        end
    end
    return closest
end

