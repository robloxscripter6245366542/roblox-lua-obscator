    if not o then return end
    for _, d in pairs(o) do pcall(function() d:Remove() end) end
    ESP[player] = nil
end

-- Project a character's bounding box to screen; returns top-left, size, onScreen.
local function boxFromCharacter(character)
    local cf, size
    local ok = pcall(function() cf, size = character:GetBoundingBox() end)
    if not ok or not cf then return nil end
    local corners = {
        Vector3.new( size.X,  size.Y,  size.Z), Vector3.new(-size.X,  size.Y,  size.Z),
        Vector3.new( size.X, -size.Y,  size.Z), Vector3.new(-size.X, -size.Y,  size.Z),
        Vector3.new( size.X,  size.Y, -size.Z), Vector3.new(-size.X,  size.Y, -size.Z),
        Vector3.new( size.X, -size.Y, -size.Z), Vector3.new(-size.X, -size.Y, -size.Z),
    }
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local anyOn = false
    for _, c in ipairs(corners) do
        local sp, on = worldToScreen((cf * CFrame.new(c * 0.5)).Position)
        if on then anyOn = true end
        minX = math.min(minX, sp.X); minY = math.min(minY, sp.Y)
        maxX = math.max(maxX, sp.X); maxY = math.max(maxY, sp.Y)
    end
    if not anyOn then return nil end
    return Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY)
end

local function updateEsp()
    if not hasDrawing then return end
    local localCharacter = LocalPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local o = ESP[player]
        if not Config.ESPEnabled then
            if o then hideEsp(o) end
            continue
        end
        if not o then o = newEspObjects(); ESP[player] = o end
        if not o then continue end

        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not character or not humanoid or not hrp or humanoid.Health <= 0 then
            hideEsp(o); continue
        end

        local topLeft, size = boxFromCharacter(character)
        if not topLeft then hideEsp(o); continue end

        local col = Config.ESPColor

        -- box
        o.box.Visible = Config.ESPBox
        if Config.ESPBox then
            o.box.Position = topLeft; o.box.Size = size; o.box.Color = col
        end

        -- name
        o.name.Visible = Config.ESPName
        if Config.ESPName then
            o.name.Text = player.Name
            o.name.Position = Vector2.new(topLeft.X + size.X / 2, topLeft.Y - 16)
            o.name.Color = col
        end

        -- distance
        o.dist.Visible = Config.ESPDistance and localRoot ~= nil
        if o.dist.Visible then
            local d = math.floor((localRoot.Position - hrp.Position).Magnitude)
            o.dist.Text = string.format("%dm", d)
            o.dist.Position = Vector2.new(topLeft.X + size.X / 2, topLeft.Y + size.Y + 2)
            o.dist.Color = col
        end

        -- health bar (left side, green→red)
        local showHp = Config.ESPHealth
        o.healthBg.Visible = showHp
        o.healthFg.Visible = showHp
        if showHp then
            local frac = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
            local barX = topLeft.X - 5
            o.healthBg.Position = Vector2.new(barX, topLeft.Y)
            o.healthBg.Size     = Vector2.new(3, size.Y)
            local h = size.Y * frac
            o.healthFg.Position = Vector2.new(barX, topLeft.Y + (size.Y - h))
            o.healthFg.Size     = Vector2.new(3, h)
            o.healthFg.Color    = Color3.fromRGB(math.floor(255 * (1 - frac)), math.floor(255 * frac), 40)
        end

        -- tracer (from bottom center of screen)
        o.tracer.Visible = Config.ESPTracer
        if Config.ESPTracer then
            local v = Camera.ViewportSize
            o.tracer.From = Vector2.new(v.X / 2, v.Y)
            o.tracer.To   = Vector2.new(topLeft.X + size.X / 2, topLeft.Y + size.Y)
            o.tracer.Color = col
        end
    end
end

