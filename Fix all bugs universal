                fov_circle.Radius = Config.FOVRadius
                fov_circle.NumSides = Config.FOVSides
                fov_circle.Filled = Config.FOVFilled
                fov_circle.Visible = Config.FOVVisible
            end
            setEnabled(Config.Enabled)
            setCameraLock(Config.CameraLock)
            WindUI:Notify({ Title = "Loaded", Content = chosen, Duration = 4, Icon = "check" })
        else
            WindUI:Notify({ Title = "Nothing to load", Content = "Pick a config first.", Duration = 4, Icon = "x" })
        end
    end,
})

