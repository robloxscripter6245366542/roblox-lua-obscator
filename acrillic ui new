-- ──────────────────────────────────────────────────────────────────────
-- PHYSICS ENGINE (Spring-based animations)
-- ──────────────────────────────────────────────────────────────────────
local Physics = {}
Physics.__index = Physics

function Physics.new(mass, stiffness, damping)
    local self = setmetatable({}, Physics)
    self.mass = mass or 1
    self.stiffness = stiffness or 100
    self.damping = damping or 10
    self.position = 0
    self.velocity = 0
    self.target = 0
    return self
end

function Physics:update(dt)
    local force = -self.stiffness * (self.position - self.target)
    local dampingForce = -self.damping * self.velocity
    local acceleration = (force + dampingForce) / self.mass
    self.velocity = self.velocity + acceleration * dt
    self.position = self.position + self.velocity * dt
    return self.position
end

function Physics:setTarget(target)
    self.target = target
end

function Physics:isAtRest(threshold)
    threshold = threshold or 0.01
    return math.abs(self.velocity) < threshold and math.abs(self.position - self.target) < threshold
end

-- ──────────────────────────────────────────────────────────────────────
-- PARTICLE SYSTEM ENGINE
-- ──────────────────────────────────────────────────────────────────────
local ParticleSystem = {}
ParticleSystem.__index = ParticleSystem

function ParticleSystem.new(parent, config)
    local self = setmetatable({}, ParticleSystem)
    self.parent = parent
    self.config = config or {}
    self.particles = {}
    self.active = false
    self.connections = {}
    return self
end

function ParticleSystem:emit(x, y, count, config)
    config = config or {}
    local color = config.color or c.Particle.Primary
    local size = config.size or 4
    local lifetime = config.lifetime or 1.5
    local velocity = config.velocity or Vector2.new(0, -50)
    local spread = config.spread or 30
    local gravity = config.gravity or Vector2.new(0, 100)
    
    for i = 1, (count or 10) do
        local angle = math.rad(math.random(-spread, spread))
        local speed = math.random(30, 80)
        local vel = Vector2.new(
            velocity.X + math.cos(angle) * speed,
            velocity.Y + math.sin(angle) * speed
        )
        
        local particle = Make("Frame", {
            BackgroundColor3 = color,
            BackgroundTransparency = 0.3,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, x, 0, y),
            Size = UDim2.new(0, size, 0, size),
            ZIndex = self.parent.ZIndex + 100,
            Parent = self.parent,
        })
        Corner(particle, sz.Pill)
        
        table.insert(self.particles, {
            frame = particle,
            velocity = vel,
            gravity = gravity,
            lifetime = lifetime,
            age = 0,
            size = size,
        })
    end
    
    if not self.active then
        self.active = true
        self:startUpdate()
    end
end

function ParticleSystem:startUpdate()
    local conn = rs.RenderStepped:Connect(function(dt)
        local toRemove = {}
        
        for i, p in ipairs(self.particles) do
            p.age = p.age + dt
            p.velocity = p.velocity + p.gravity * dt
            
            local pos = p.frame.Position
            local newPos = UDim2.new(
                0, pos.X.Offset + p.velocity.X * dt,
                0, pos.Y.Offset + p.velocity.Y * dt
            )
            p.frame.Position = newPos
            
            local progress = p.age / p.lifetime
            p.frame.BackgroundTransparency = 0.3 + progress * 0.7
            p.frame.Size = UDim2.new(0, p.size * (1 - progress * 0.5), 0, p.size * (1 - progress * 0.5))
            
            if p.age >= p.lifetime then
                table.insert(toRemove, i)
            end
        end
        
        for i = #toRemove, 1, -1 do
            local idx = toRemove[i]
            if self.particles[idx] and self.particles[idx].frame then
                self.particles[idx].frame:Destroy()
            end
            table.remove(self.particles, idx)
        end
        
        if #self.particles == 0 then
            self.active = false
            conn:Disconnect()
        end
    end)
    
    table.insert(self.connections, conn)
end

function ParticleSystem:destroy()
    for _, conn in ipairs(self.connections) do
        conn:Disconnect()
    end
    for _, p in ipairs(self.particles) do
        if p.frame then p.frame:Destroy() end
    end
    self.particles = {}
end

