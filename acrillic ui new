        TextColor3 = c.TextDim,
        FontFace = font.Medium,
        TextSize = fs.Small,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 112, 1, 0),
        ZIndex = 73,
        Parent = actions,
    })
    Corner(cancel, sz.Radius)
    local accept = Make("TextButton", {
        BackgroundColor3 = c.Accent,
        Text = acceptText,
        TextColor3 = c.Base,
        FontFace = font.Bold,
        TextSize = fs.Small,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -120, 0, 0),
        Size = UDim2.new(0, 112, 1, 0),
        ZIndex = 73,
        Parent = actions,
    })
    Corner(accept, sz.Radius)

    local closed = false
    local function close(callback)
        if closed then return end
        closed = true
        Tween(overlay, { BackgroundTransparency = 1, GroupTransparency = 1 }, ease.Swift)
        Tween(card, { Position = UDim2.new(0.5, 0, 0.5, 18) }, ease.Swift)
        task.delay(ease.Swift[1], function()
            if overlay.Parent then overlay:Destroy() end
        end)
        task.spawn(callback)
    end

    cancel.MouseButton1Click:Connect(function() close(cancelled) end)
    accept.MouseButton1Click:Connect(function() close(accepted) end)
    Tween(overlay, { BackgroundTransparency = 0.38, GroupTransparency = 0 }, ease.Smooth)
    Tween(card, { Position = UDim2.new(0.5, 0, 0.5, 0) }, ease.Spring)

    return {
        Close = function() close(cancelled) end,
        Accept = function() close(accepted) end,
    }
end

function Library:CreateQuickSearch()
    if self._quickSearch then return self._quickSearch end

    local box = Make("TextBox", {
        Name = "QuickSearch",
        BackgroundColor3 = c.SurfaceSunken,
        BackgroundTransparency = 0.35,
        ClearTextOnFocus = false,
        PlaceholderText = "Search tabs...",
        PlaceholderColor3 = c.TextMuted,
        Text = "",
        TextColor3 = c.Text,
        FontFace = font.Regular,
        TextSize = fs.Small,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.new(1, -252, 0.5, -15),
        Size = UDim2.new(0, 158, 0, 30),
        Parent = self.topBar,
    })
    Corner(box, sz.Radius)
    local stroke = Stroke(box, c.BorderSubtle, 1, 0.22)
    Pad(box, 0, 0, 11, 11)

    local function filter(query)
        query = string.lower(query)
        local firstMatch = nil
        for _, section in ipairs(self.sections) do
            local sectionHasMatch = false
            for _, tab in ipairs(section.tabs) do
                local visible = query == "" or string.find(string.lower(tab.name), query, 1, true) ~= nil
                tab.button.Visible = visible
                sectionHasMatch = sectionHasMatch or visible
                if visible and not firstMatch then firstMatch = tab end
            end
            section.frame.Visible = sectionHasMatch
        end
        if firstMatch and self.currentTab and not self.currentTab.button.Visible then
            Library._SelectTab(self, firstMatch)
        end
    end

    local changed = box:GetPropertyChangedSignal("Text"):Connect(function()
        filter(box.Text)
    end)
    local focused = box.Focused:Connect(function()
        Tween(box, { BackgroundTransparency = 0.08 }, ease.Swift)
        Tween(stroke, { Color = c.BorderAccent, Transparency = 0 }, ease.Swift)
    end)
    local unfocused = box.FocusLost:Connect(function()
        Tween(box, { BackgroundTransparency = 0.35 }, ease.Smooth)
        Tween(stroke, { Color = c.BorderSubtle, Transparency = 0.22 }, ease.Smooth)
    end)
    table.insert(self._conns, changed)
    table.insert(self._conns, focused)
    table.insert(self._conns, unfocused)
    self._quickSearch = {
        Focus = function() box:CaptureFocus() end,
        SetText = function(_, value) box.Text = tostring(value or "") end,
        Clear = function() box.Text = "" end,
    }
    return self._quickSearch
end

