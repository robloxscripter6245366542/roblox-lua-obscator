-- INTERACTION LAYER
-- Reusable overlay, tooltip, quick-search, and confirmation helpers.

function Library:Tooltip(target, text)
    assert(target and target:IsA("GuiObject"), "Tooltip target must be a GuiObject")

    local bubble = Make("TextLabel", {
        Name = "Tooltip",
        BackgroundColor3 = c.SurfaceElevated,
        BackgroundTransparency = 1,
        TextColor3 = c.TextDim,
        TextTransparency = 1,
        FontFace = font.Medium,
        Text = tostring(text or ""),
        TextSize = fs.Small,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(0, 220, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 80,
        Parent = self.gui,
    })
    Corner(bubble, sz.Radius)
    Stroke(bubble, c.Border, 1, 0.18)
    Pad(bubble, 9, 9, 11, 11)

    local function position()
        local absolute = target.AbsolutePosition
        local size = target.AbsoluteSize
        local x = math.clamp(absolute.X, 12, math.max(12, self.gui.AbsoluteSize.X - 232))
        local y = math.clamp(absolute.Y + size.Y + 8, 12, math.max(12, self.gui.AbsoluteSize.Y - bubble.AbsoluteSize.Y - 12))
        bubble.Position = UDim2.fromOffset(x, y)
    end

    local enter = target.MouseEnter:Connect(function()
        position()
        bubble.Visible = true
        Tween(bubble, { BackgroundTransparency = 0.08, TextTransparency = 0 }, ease.Smooth)
    end)
    local leave = target.MouseLeave:Connect(function()
        Tween(bubble, { BackgroundTransparency = 1, TextTransparency = 1 }, ease.Swift)
        task.delay(ease.Swift[1], function()
            if bubble.Parent and bubble.TextTransparency >= 0.99 then
                bubble.Visible = false
            end
        end)
    end)

    table.insert(self._conns, enter)
    table.insert(self._conns, leave)
    return {
        SetText = function(_, value)
            bubble.Text = tostring(value or "")
        end,
        Destroy = function()
            enter:Disconnect()
            leave:Disconnect()
            bubble:Destroy()
        end,
    }
end

