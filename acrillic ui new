-- ──────────────────────────────────────────────────────────────────────
-- ADVANCED RIPPLE EFFECT (Multi-layer, physics-based)
-- ──────────────────────────────────────────────────────────────────────
local function Ripple(parent, inputPos, col, maxSz)
    local pPos, pSz = parent.AbsolutePosition, parent.AbsoluteSize
    local rx, ry = math.clamp(inputPos.X - pPos.X, 0, pSz.X), math.clamp(inputPos.Y - pPos.Y, 0, pSz.Y)
    maxSz = maxSz or math.max(pSz.X, pSz.Y) * 2.5
    
    local circle1 = Make("Frame", {
        BackgroundColor3 = col or c.Ripple,
        BackgroundTransparency = 0.7,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, rx, 0, ry),
        Size = UDim2.new(0, 0, 0, 0),
        ZIndex = (parent.ZIndex or 1) + 60,
        Parent = parent,
    })
    Corner(circle1, sz.Pill)
    Tween(circle1, {
        Size = UDim2.new(0, maxSz, 0, maxSz),
        BackgroundTransparency = 1,
    }, ease.Fluid, 0.6)
    
    task.delay(0.05, function()
        local circle2 = Make("Frame", {
            BackgroundColor3 = col or c.Ripple,
            BackgroundTransparency = 0.85,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, rx, 0, ry),
            Size = UDim2.new(0, 0, 0, 0),
            ZIndex = (parent.ZIndex or 1) + 59,
            Parent = parent,
        })
        Corner(circle2, sz.Pill)
        Tween(circle2, {
            Size = UDim2.new(0, maxSz * 0.7, 0, maxSz * 0.7),
            BackgroundTransparency = 1,
        }, ease.Smooth, 0.5)
        task.delay(0.55, function()
            if circle2 and circle2.Parent then circle2:Destroy() end
        end)
    end)
    
    task.delay(0.65, function()
        if circle1 and circle1.Parent then circle1:Destroy() end
    end)
end

-- ──────────────────────────────────────────────────────────────────────
-- ADVANCED GLOW EFFECT (Pulsing, animated)
-- ──────────────────────────────────────────────────────────────────────
local function GlowEffect(parent, color, intensity)
    local glow = Make("Frame", {
        BackgroundColor3 = color or c.Glow,
        BackgroundTransparency = 0.7,
        Size = UDim2.new(1, 20, 1, 20),
        Position = UDim2.new(0, -10, 0, -10),
        ZIndex = (parent.ZIndex or 1) - 1,
        Parent = parent,
    })
    Corner(glow, sz.RadiusLg)
    Make("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.3),
            NumberSequenceKeypoint.new(0.5, 0.7),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Parent = glow,
    })
    
    local conn = rs.RenderStepped:Connect(function()
        local t = tick() % 2
        local pulse = math.sin(t * math.pi) * 0.5 + 0.5
        glow.BackgroundTransparency = 0.7 - pulse * 0.2 * (intensity or 1)
    end)
    
    return {
        glow = glow,
        destroy = function()
            conn:Disconnect()
            if glow then glow:Destroy() end
        end,
    }
end

-- ──────────────────────────────────────────────────────────────────────
-- ADVANCED DRAGGABLE (With momentum and bounds)
-- ──────────────────────────────────────────────────────────────────────
local function MakeDraggable(frame, handle, conns)
    local dragging = false
    local dragStart, startPos
    local mConn, eConn
    local velocity = Vector2.new(0, 0)
    local lastPos = Vector2.new(0, 0)
    local lastTime = 0
    
    local c1 = (handle or frame).InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        lastPos = input.Position
        lastTime = tick()
        
        mConn = ui.InputChanged:Connect(function(mi)
            if not dragging then return end
            if mi.UserInputType ~= Enum.UserInputType.MouseMovement
            and mi.UserInputType ~= Enum.UserInputType.Touch then return end
            
            local d = mi.Position - dragStart
            local newPos = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
            frame.Position = newPos
            
            local currentTime = tick()
            local dt = currentTime - lastTime
            if dt > 0 then
                velocity = (mi.Position - lastPos) / dt
            end
            lastPos = mi.Position
            lastTime = currentTime
        end)
        
        eConn = ui.InputEnded:Connect(function(ei)
            if ei.UserInputType ~= Enum.UserInputType.MouseButton1
            and ei.UserInputType ~= Enum.UserInputType.Touch then return end
            
            dragging = false
            if mConn then mConn:Disconnect(); mConn = nil end
            if eConn then eConn:Disconnect(); eConn = nil end
            
            if velocity.Magnitude > 100 then
                local momentum = velocity * 0.3
                Tween(frame, {
                    Position = UDim2.new(
                        frame.Position.X.Scale, frame.Position.X.Offset + momentum.X,
                        frame.Position.Y.Scale, frame.Position.Y.Offset + momentum.Y
                    ),
                }, ease.Fluid, 0.5)
            end
        end)
    end)
    
    if conns then table.insert(conns, c1) end
end

