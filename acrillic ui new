-- ──────────────────────────────────────────────────────────────────────
-- RESIZE HANDLER
-- ──────────────────────────────────────────────────────────────────────
function Library:_SetupResize(handle)
    local resizing = false
    local rStart, sStart
    local mConn, eConn
    
    table.insert(self._conns, handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        
        resizing = true
        rStart = input.Position
        sStart = self.container.AbsoluteSize
        
        mConn = ui.InputChanged:Connect(function(mi)
            if not resizing then return end
            if mi.UserInputType ~= Enum.UserInputType.MouseMovement
            and mi.UserInputType ~= Enum.UserInputType.Touch then return end
            
            local d = mi.Position - rStart
            local nw = math.clamp(sStart.X + d.X, self._minSz.X, self._maxSz.X)
            local nh = math.clamp(sStart.Y + d.Y, self._minSz.Y, self._maxSz.Y)
            self.container.Size = UDim2.new(0, nw, 0, nh)
            self._origW = nw
            self._origH = nh
        end)
        
        eConn = ui.InputEnded:Connect(function(ei)
            if ei.UserInputType ~= Enum.UserInputType.MouseButton1
            and ei.UserInputType ~= Enum.UserInputType.Touch then return end
            
            resizing = false
            Tween(handle, { ImageColor3 = c.TextMuted }, ease.Swift)
            if mConn then mConn:Disconnect(); mConn = nil end
            if eConn then eConn:Disconnect(); eConn = nil end
        end)
    end))
end

-- ──────────────────────────────────────────────────────────────────────
-- MINIMIZE / RESTORE
-- ──────────────────────────────────────────────────────────────────────
function Library:_ToggleMinimize()
    self.minimized = not self.minimized
    
    if self.minimized then
        if self._blur then self._blur:SetEnabled(false) end
        Tween(self.mainContent, { Size = UDim2.new(1, 0, 0, 0) }, ease.Fluid)
        task.delay(0.05, function()
            Tween(self.container, {
                Size = UDim2.new(0, self.container.AbsoluteSize.X, 0, sz.TopBar + 1),
            }, ease.Fluid)
        end)
        if self.resizeBtn then self.resizeBtn.Visible = false end
    else
        if self._blur then self._blur:SetEnabled(true) end
        Tween(self.container, {
            Size = UDim2.new(0, self.container.AbsoluteSize.X, 0, self._origH),
        }, ease.Fluid)
        task.delay(ease.Fluid[1], function()
            if self.mainContent and self.mainContent.Parent then
                Tween(self.mainContent, { Size = UDim2.new(1, 0, 1, -(sz.TopBar + 1)) }, ease.Smooth)
            end
        end)
        if self.resizeBtn then self.resizeBtn.Visible = true end
    end
end

-- ──────────────────────────────────────────────────────────────────────
-- DESTROY
-- ──────────────────────────────────────────────────────────────────────
function Library:Destroy()
    if self._autoSave then self:SaveConfig(self._currentCfg) end
    
    for _, cn in ipairs(self._conns) do
        if typeof(cn) == "RBXScriptConnection" then cn:Disconnect() end
    end
    self._conns = {}
    
    for _, ps in ipairs(self._particles) do
        ps:destroy()
    end
    
    if self._blur then self._blur:Destroy() end
    
    Tween(self.container, {
        BackgroundTransparency = 1,
        Position = UDim2.new(
            self.container.Position.X.Scale,
            self.container.Position.X.Offset,
            self.container.Position.Y.Scale,
            self.container.Position.Y.Offset + 30
        ),
    }, ease.Fluid)
    
    task.delay(ease.Fluid[1] + 0.05, function()
        if self.gui then self.gui:Destroy() end
    end)
end

-- ──────────────────────────────────────────────────────────────────────
-- CONFIG SYSTEM
-- ──────────────────────────────────────────────────────────────────────
function Library:_RegisterCfg(id, kind, get, set)
    self._cfgElements[id] = { kind = kind, getValue = get, setValue = set }
end

function Library:SaveConfig(name)
    name = tostring(name or "default")
    local data = { _theme = self._currentTheme }
    for id, el in pairs(self._cfgElements) do
        local v = el.getValue()
        if typeof(v) == "Color3" then
            v = { R = v.R, G = v.G, B = v.B, _t = "c3" }
        elseif typeof(v) == "EnumItem" then
            v = { _t = "enum", _e = tostring(v.EnumType), _v = v.Name }
        end
        data[id] = v
    end
    self._savedConfigs[name] = data
    self._currentCfg = name
    if HasFileApi() then
        EnsureFolder(self.configFolder)
        local ok = pcall(function()
            writefile(self.configFolder .. "/" .. name .. ".json", hs:JSONEncode(data))
        end)
        if not ok then
            self:Notify({ Title = "Saved in Memory", Description = name, Type = "warning" })
            return true
        end
    end
    self:Notify({ Title = "Saved", Description = name, Type = "success" })
    return true
end

function Library:LoadConfig(name)
    name = tostring(name or "default")
    local data = self._savedConfigs[name]
    if not data and HasFileApi() then
        local path = self.configFolder .. "/" .. name .. ".json"
        if isfile(path) then
            local ok, decoded = pcall(function()
                return hs:JSONDecode(readfile(path))
            end)
            if ok and type(decoded) == "table" then
                data = decoded
                self._savedConfigs[name] = data
            end
        end
    end
    if not data then
        self:Notify({ Title = "Not Found", Description = name, Type = "error" })
        return false
    end
    
    if data._theme and THEMES[data._theme] then
        self:SetTheme(data._theme)
    end
    
    for id, v in pairs(data) do
        if id ~= "_theme" and self._cfgElements[id] then
            if type(v) == "table" and v._t == "c3" then
                v = Color3.new(v.R, v.G, v.B)
            elseif type(v) == "table" and v._t == "enum" then
                v = Enum[v._e][v._v]
            end
            pcall(function() self._cfgElements[id].setValue(v) end)
        end
    end
    
    self._currentCfg = name
    self:Notify({ Title = "Loaded", Description = name, Type = "success" })
    return true
end

function Library:DeleteConfig(name)
    name = tostring(name or "default")
    local existed = self._savedConfigs[name] ~= nil
    self._savedConfigs[name] = nil
    if HasFileApi() and type(delfile) == "function" then
        local path = self.configFolder .. "/" .. name .. ".json"
        if isfile(path) then
            delfile(path)
            existed = true
        end
    end
    if existed then
        self:Notify({ Title = "Deleted", Description = name, Type = "success" })
        return true
    end
    return false
end

function Library:GetConfigs()
    local seen = {}
    for name in pairs(self._savedConfigs) do
        seen[name] = true
    end
    for _, name in ipairs(GetConfigs(self.configFolder)) do
        seen[name] = true
    end
    local names = {}
    for name in pairs(seen) do
        table.insert(names, name)
    end
    table.sort(names)
    return names
end

function Library:SetAutoSave(v)
    self._autoSave = v
    if v and not self._autoSaveLoop then
        self._autoSaveLoop = true
        task.spawn(function()
            while self._autoSave and self.gui and self.gui:IsDescendantOf(game) do
                task.wait(30)
                if self._autoSave then self:SaveConfig(self._currentCfg) end
            end
            self._autoSaveLoop = false
        end)
    end
end

-- ──────────────────────────────────────────────────────────────────────
-- THEME SWITCHING ENGINE (Optimized)
-- ──────────────────────────────────────────────────────────────────────
function Library:SetTheme(themeName)
    if not THEMES[themeName] then return false end
    
    local oldTheme = self._currentThemeData or c
    currentThemeName = themeName
    c = THEMES[themeName]
    self._currentTheme = themeName
    self._currentThemeData = c
    
    local function updateRecursive(instance)
        for _, child in ipairs(instance:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextLabel")
            or child:IsA("TextBox") or child:IsA("ImageLabel") or child:IsA("UIStroke") then
                
                if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextBox") then
                    if child.BackgroundColor3 == oldTheme.Background then
                        Tween(child, { BackgroundColor3 = c.Background }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.Surface then
                        Tween(child, { BackgroundColor3 = c.Surface }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.SurfaceHover then
                        Tween(child, { BackgroundColor3 = c.SurfaceHover }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.SurfaceActive then
                        Tween(child, { BackgroundColor3 = c.SurfaceActive }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.SurfaceElevated then
                        Tween(child, { BackgroundColor3 = c.SurfaceElevated }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.DangerSurface then
                        Tween(child, { BackgroundColor3 = c.DangerSurface }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.SuccessSurface then
                        Tween(child, { BackgroundColor3 = c.SuccessSurface }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.Notif.Bg then
                        Tween(child, { BackgroundColor3 = c.Notif.Bg }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.Toggle.On then
                        Tween(child, { BackgroundColor3 = c.Toggle.On }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.Toggle.Off then
                        Tween(child, { BackgroundColor3 = c.Toggle.Off }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.Toggle.Thumb then
                        Tween(child, { BackgroundColor3 = c.Toggle.Thumb }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.Toggle.ThumbOn then
                        Tween(child, { BackgroundColor3 = c.Toggle.ThumbOn }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.Accent then
                        Tween(child, { BackgroundColor3 = c.Accent }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.Danger then
                        Tween(child, { BackgroundColor3 = c.Danger }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.Notif.Ok then
                        Tween(child, { BackgroundColor3 = c.Notif.Ok }, ease.Smooth)
                    elseif child.BackgroundColor3 == oldTheme.Notif.Error then
                        Tween(child, { BackgroundColor3 = c.Notif.Error }, ease.Smooth)
                    end
                end
                
                if child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("ImageLabel") then
                    local isText = child:IsA("TextLabel") or child:IsA("TextBox")
                    local prop = isText and "TextColor3" or "ImageColor3"
                    local val = isText and child.TextColor3 or child.ImageColor3
                    
                    if val == oldTheme.Text then
                        Tween(child, { [prop] = c.Text }, ease.Smooth)
                    elseif val == oldTheme.TextDim then
                        Tween(child, { [prop] = c.TextDim }, ease.Smooth)
                    elseif val == oldTheme.TextSubtle then
                        Tween(child, { [prop] = c.TextSubtle }, ease.Smooth)
                    elseif val == oldTheme.TextMuted then
                        Tween(child, { [prop] = c.TextMuted }, ease.Smooth)
                    elseif val == oldTheme.Accent then
                        Tween(child, { [prop] = c.Accent }, ease.Smooth)
                    elseif val == oldTheme.Danger then
                        Tween(child, { [prop] = c.Danger }, ease.Smooth)
                    elseif val == oldTheme.Success then
                        Tween(child, { [prop] = c.Success }, ease.Smooth)
                    end
                end
                
                if child:IsA("UIStroke") then
                    if child.Color == oldTheme.Border then
                        Tween(child, { Color = c.Border }, ease.Smooth)
                    elseif child.Color == oldTheme.BorderSubtle then
                        Tween(child, { Color = c.BorderSubtle }, ease.Smooth)
                    elseif child.Color == oldTheme.BorderFocus then
                        Tween(child, { Color = c.BorderFocus }, ease.Smooth)
                    elseif child.Color == oldTheme.BorderAccent then
                        Tween(child, { Color = c.BorderAccent }, ease.Smooth)
                    end
                end
            end
            updateRecursive(child)
        end
    end
    
    if self.gui then updateRecursive(self.gui) end
    
    if self._themeDropdown then
        self._themeDropdown._suppressCb = true
        self._themeDropdown:SetValue(themeName)
        self._themeDropdown._suppressCb = false
    end
    
    return true
end

