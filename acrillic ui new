local function Card(tab, name, height, autoSize)
    local f = Make("Frame", {
        Name = name,
        BackgroundColor3 = c.Surface,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = autoSize
            and UDim2.new(1, 0, 0, 0)
