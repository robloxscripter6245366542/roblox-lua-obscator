--============================================================================
-- Camera aim (shiftlock-style "look at target" fixup)
--============================================================================
local aimTarget        -- Vector3 the camera should look at, or nil
local lastCamRotation  -- cached rotation used when cameraSlowness > 0

RunService:BindToRenderStep("ShiftlockAimFix", Enum.RenderPriority.Camera.Value + 1, function()
	if not aimTarget then
		lastCamRotation = nil
		return
	end
	local camera = getCamera()
	if not camera then
		return
	end

	local camPos  = camera.CFrame.Position
	local desired = CFrame.new(camPos, aimTarget)

	if settings.cameraSlowness <= 0 then
		camera.CFrame  = desired
		lastCamRotation = desired.Rotation
	else
		local current = (lastCamRotation and (CFrame.new(camPos) * lastCamRotation)) or camera.CFrame
		local alpha   = 1 / ((settings.cameraSlowness * 3) + 1)
		local result  = current:Lerp(desired, math.clamp(alpha, 0, 1))
		camera.CFrame  = result
		lastCamRotation = result.Rotation
	end
end)

-- Snap the camera onto the last aim target, then hand control back to the game.
local function releaseCamera()
	if not aimTarget then
		return
	end
	local target = aimTarget
	aimTarget       = nil
	lastCamRotation = nil

	local camera = getCamera()
	if camera then
		local final = CFrame.new(camera.CFrame.Position, target)
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame     = final
		task.defer(function()
			camera.CameraType = Enum.CameraType.Custom
		end)
	end
end

--============================================================================
-- Helpers
--============================================================================
-- Pull the numeric asset id out of an AnimationId string ("rbxassetid://123" -> "123").
local function extractAnimationId(animation)
	if not animation then
		return ""
	end
	local text = tostring(animation)
	return text:match("%d+") or text
end

-- Nearest living enemy's HumanoidRootPart (respects maxTargetDistance; 0 = no limit).
local function getNearestEnemy()
	if not character or not rootPart then
		return nil
	end
	local nearest, nearestDist = nil, math.huge
	local origin  = rootPart.Position
	local maxDist = settings.maxTargetDistance or 0

	for _, model in ipairs(workspace:GetDescendants()) do
		if model:IsA("Model") and model ~= character then
			local hum = model:FindFirstChildOfClass("Humanoid")
			local hrp = model:FindFirstChild("HumanoidRootPart")
			if hum and hrp and hum.Health > 0 then
				local dist = (hrp.Position - origin).Magnitude
				if dist < nearestDist and (maxDist <= 0 or dist <= maxDist) then
					nearestDist = dist
					nearest     = hrp
				end
			end
		end
	end
	return nearest
end

--============================================================================
-- Core: react to a blackflash animation
--============================================================================
local function onAnimationPlayed(track)
	if not settings.masterEnabled then
		return
	end

	local animId = extractAnimationId(track.Animation and track.Animation.AnimationId)
	if not REACT_ANIMATION_IDS[animId] then
		return
	end

	reactionCounter += 1
	local myReaction = reactionCounter

	----------------------------------------------------------------------
	-- Feint (only if the enemy is facing us)
	----------------------------------------------------------------------
	if settings.feintEnabled then
		task.spawn(function()
			task.wait(settings.feintDelay)
			if character and rootPart then
				local enemy = getNearestEnemy()
				if enemy then
					local toMe      = rootPart.Position - enemy.Position
					local enemyLook = enemy.CFrame.LookVector
					if enemyLook:Dot(toMe.Unit) >= 0 then
						pcall(function()
							ReplicatedStorage:WaitForChild("Knit"):WaitForChild("Knit")
								:WaitForChild("Services"):WaitForChild("ItadoriService")
								:WaitForChild("RE"):WaitForChild("RightActivated"):FireServer()
						end)
					end
				end
			end
		end)
	end

	----------------------------------------------------------------------
	-- Auto jump (hold upward velocity briefly)
	----------------------------------------------------------------------
	if settings.autoJump and rootPart then
		task.spawn(function()
			local deadline = os.clock() + settings.jumpDuration
			while os.clock() < deadline and settings.autoJump and rootPart and rootPart.Parent do
				pcall(function()
					local v = rootPart.AssemblyLinearVelocity
					rootPart.AssemblyLinearVelocity = Vector3.new(v.X, settings.jumpPower, v.Z)
				end)
				RunService.Heartbeat:Wait()
			end
		end)
	end

	----------------------------------------------------------------------
	-- Auto fire "Divergent Fist"
	----------------------------------------------------------------------
	if settings.autoFireFist then
		task.spawn(function()
			task.wait(settings.divergentFistDelay)
			pcall(function()
				local char    = LocalPlayer.Character
				local moveset = char and char:FindFirstChild("Moveset")
				if moveset then
					local fist = moveset:FindFirstChild("Divergent Fist")
					if fist then
						ReplicatedStorage:WaitForChild("Knit"):WaitForChild("Knit")
							:WaitForChild("Services"):WaitForChild("DivergentFistService")
							:WaitForChild("RE"):WaitForChild("Activated"):FireServer(fist)
					end
				end
			end)
		end)
	end

	----------------------------------------------------------------------
	-- Auto blackflash chain + auto aim
	----------------------------------------------------------------------
	if settings.autoBFChain or settings.autoAim then
		task.spawn(function()
			local startTime = os.clock()
			local startPos  = rootPart.Position
			local mode      = "normal"   -- normal | nothing | 360_left/right | 270_left/right
			local enemy     = getNearestEnemy()

			-- Side check -> 270 spin (enemy roughly perpendicular to us)
			if settings.autoBFChain and settings.bfChainMode == "legit"
				and settings.legitSideCheck and enemy then
				local toMe      = startPos - enemy.Position
				local enemyLook = enemy.CFrame.LookVector
				if math.abs(enemyLook:Dot(toMe.Unit)) < 0.8 then
					local objSpace = rootPart.CFrame:VectorToObjectSpace(enemy.CFrame.LookVector)
					mode = (objSpace.X > 0) and "270_right" or "270_left"
				end
			end

			-- Behind check -> 360 spin (we are behind the enemy)
			if mode == "normal" and settings.autoBFChain and settings.bfChainMode == "legit"
				and settings.legitBehindCheck and enemy then
				local toMe      = startPos - enemy.Position
				local enemyLook = enemy.CFrame.LookVector
				if toMe.Magnitude <= settings.legitBehindCheckDist and enemyLook:Dot(toMe.Unit) < 0 then
					if math.random(1, 2) == 1 then
						local objSpace = enemy.CFrame:PointToObjectSpace(startPos)
						mode = (objSpace.X < 0) and "360_left" or "360_right"
					else
						mode = "nothing"
					end
				end
			end

			if mode == "nothing" then
				releaseCamera()
				return
			end

			local isSpin = (mode == "360_left") or (mode == "360_right")
				or (mode == "270_left") or (mode == "270_right")

			local extraSpeed      = 0
			local slowdownStarted = false
			local slowdownAnchor  = 0
			local lastProgress    = 0

			while true do
				local duration = (settings.bfChainMode == "legit" and settings.autoBFChain
					and (settings.legitSpeed + extraSpeed)) or settings.tweenTime
				local totalTime = duration + settings.lookTime
				local elapsed   = os.clock() - startTime

				if elapsed >= totalTime then
					break
				end
				if myReaction ~= reactionCounter or not character.Parent or not rootPart.Parent then
					releaseCamera()
					return
				end

				local enemyNow = getNearestEnemy()
				if enemyNow then
					local enemyPos = enemyNow.Position
					local doChain  = settings.autoBFChain
					local lookAt   = enemyPos

					-- In-front check: skip chaining if enemy is too far or not in front.
					if doChain and settings.bfChainMode == "legit" and not isSpin then
						local delta = enemyPos - startPos
						local dist  = delta.Magnitude
						if dist > 0.1 then
							local dot = rootPart.CFrame.LookVector:Dot(delta.Unit)
							if dist > settings.legitInfrontCheck or dot < 0.4 then
								doChain = false
							end
						else
							doChain = false
						end
					end

					-- Compute where to *look* (arc offset for the non-spin legit case).
					if doChain and settings.bfChainMode == "legit" then
						if isSpin then
							lookAt = enemyPos
						else
							local arc  = settings.legitArcWidth
							local d    = startPos - enemyPos
							local ang  = math.atan2(d.Z, d.X)
							local perp = ang + (math.pi * 0.5)
							lookAt = Vector3.new(
								enemyPos.X + math.cos(perp) * arc,
								startPos.Y,
								enemyPos.Z + math.sin(perp) * arc
							)
						end
					end

					if doChain then
						if elapsed < duration then
							local progress = math.clamp(elapsed / duration, 0, 1)
							local newPos
							local yLock
							if settings.autoJump then
								yLock = rootPart.Position.Y
							end

							if settings.bfChainMode == "semi legit" then
								-- Sweep from our start angle round to a spot behind the enemy.
								local behind = enemyPos - (enemyNow.CFrame.LookVector * settings.offsetStuds)
								local radius = math.max(settings.offsetStuds, 2)
								local dStart = startPos - enemyPos
								local dEnd   = behind - enemyPos
								local a0     = math.atan2(dStart.Z, dStart.X)
								local a1     = math.atan2(dEnd.Z, dEnd.X)
								local da     = a1 - a0
								if da > math.pi then
									da -= (2 * math.pi)
								elseif da < -math.pi then
									da += (2 * math.pi)
								end
								local ang = a0 + (da * progress)
								if not yLock then
									yLock = startPos.Y + ((behind.Y - startPos.Y) * progress)
								end
								newPos = Vector3.new(
									enemyPos.X + math.cos(ang) * radius,
									yLock,
									enemyPos.Z + math.sin(ang) * radius
								)

							elseif settings.bfChainMode == "legit" then
								-- Progressive slowdown so the chain eases out.
								local threshold = isSpin and 0.25 or 0.5
								if not slowdownStarted and progress >= threshold then
									slowdownStarted = true
									slowdownAnchor  = elapsed
								end
								if slowdownStarted then
									local sinceAnchor = elapsed - slowdownAnchor
									if sinceAnchor >= settings.legitSlowdownInterval
										and settings.legitSlowdownInterval > 0 then
										local steps = math.floor(sinceAnchor / settings.legitSlowdownInterval)
										extraSpeed     += steps * settings.legitSlowdownAmount
										slowdownAnchor += steps * settings.legitSlowdownInterval
										duration = settings.legitSpeed + extraSpeed
										progress = math.clamp(elapsed / duration, 0, 1)
									end
									if progress >= 1 then
										break
									elseif progress <= lastProgress then
										break
									end
								end
								lastProgress = progress

								local arc     = settings.legitArcWidth
								local d       = startPos - enemyPos
								local baseAng = math.atan2(d.Z, d.X)
								local sweep   = math.pi
								if mode == "360_left" then
									sweep = math.pi * 2
								elseif mode == "360_right" then
									sweep = -math.pi * 2
								elseif mode == "270_left" then
									sweep = math.pi * 1.5
								elseif mode == "270_right" then
									sweep = -math.pi * 1.5
								end
								local ang = baseAng + (sweep * progress)
								if not yLock then
									yLock = startPos.Y
								end
								newPos = Vector3.new(
									enemyPos.X + math.cos(ang) * arc,
									yLock,
									enemyPos.Z + math.sin(ang) * arc
								)
							end

							-- Apply movement / aim.
							local canAim = settings.autoAim and mode ~= "360_left" and mode ~= "360_right"
							if canAim then
								if settings.aimMode == "Character" then
									rootPart.CFrame = CFrame.new(newPos, lookAt)
									releaseCamera()
								elseif settings.aimMode == "Camera" then
									rootPart.CFrame = CFrame.new(newPos) * rootPart.CFrame.Rotation
									aimTarget = lookAt
								end
							else
								rootPart.CFrame = CFrame.new(newPos) * rootPart.CFrame.Rotation
								releaseCamera()
							end

						elseif settings.autoAim and mode ~= "360_left" and mode ~= "360_right" then
							-- Past the movement window: keep aiming only.
							if settings.aimMode == "Character" then
								rootPart.CFrame = CFrame.new(rootPart.Position, lookAt)
								releaseCamera()
							elseif settings.aimMode == "Camera" then
								aimTarget = lookAt
							end
						else
							releaseCamera()
						end

					elseif settings.autoAim and mode ~= "360_left" and mode ~= "360_right" then
						-- Not chaining, aim only.
						if settings.aimMode == "Character" then
							rootPart.CFrame = CFrame.new(rootPart.Position, lookAt)
							releaseCamera()
						elseif settings.aimMode == "Camera" then
							aimTarget = lookAt
						end
					else
						releaseCamera()
					end
				else
					releaseCamera()
				end

				RunService.RenderStepped:Wait()
			end

			releaseCamera()
		end)
	end
end

-- Bind (re)character setup.
local function setupCharacter(char)
	character = char
	humanoid  = char:WaitForChild("Humanoid")
	rootPart  = char:WaitForChild("HumanoidRootPart")
	animator  = humanoid:WaitForChild("Animator")

	if animConnection then
		animConnection:Disconnect()
		animConnection = nil
	end
	animConnection = animator.AnimationPlayed:Connect(onAnimationPlayed)
end

