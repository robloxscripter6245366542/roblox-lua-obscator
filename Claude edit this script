-- Reusable title-bar builder. Returns the title bar frame + the "action" button
-- on the right (minimise "-" for the main window, close "X" for side panels).
local function buildTitleBar(parent, titleText, actionText, actionColor)
	local bar = Instance.new("Frame")
	bar.Size             = UDim2.new(1, 0, 0, 30)
	bar.BackgroundColor3  = Color3.fromRGB(20, 20, 25)
	bar.BorderSizePixel   = 0
	bar.Parent            = parent
	do
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent       = bar
		-- Square off the bottom corners so only the top is rounded.
		local filler = Instance.new("Frame")
		filler.Size            = UDim2.new(1, 0, 0, 5)
		filler.Position        = UDim2.new(0, 0, 1, -5)
		filler.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
		filler.BorderSizePixel  = 0
		filler.Parent           = bar
	end

	local title = Instance.new("TextLabel")
	title.Size                = UDim2.new(1, -30, 1, 0)
	title.BackgroundTransparency = 1
	title.Text                = titleText
	title.TextColor3           = Color3.fromRGB(255, 255, 255)
	title.TextXAlignment       = Enum.TextXAlignment.Left
	title.Font                 = Enum.Font.GothamBold
	title.TextSize             = 14
	title.Parent               = bar

	local action = Instance.new("TextButton")
	action.Size                = UDim2.new(0, 30, 1, 0)
	action.Position            = UDim2.new(1, -30, 0, 0)
	action.BackgroundTransparency = 1
	action.Text                = actionText
	action.TextColor3           = actionColor
	action.Font                 = Enum.Font.GothamBold
	action.TextSize             = 16
	action.Parent               = bar

	return bar, action
end

