--------------------------------------------------------------------
-- Dragging (main window + floating button)
--------------------------------------------------------------------
local function makeDraggable(handle, target, onMove)
	local dragging   = false
	local dragInput  -- the movement InputObject we're tracking
	local dragStart
	local startPos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging  = true
			dragStart = input.Position
			startPos  = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
			if onMove then
				onMove()
			end
		end
	end)
end

makeDraggable(reopenButton, reopenButton)
makeDraggable(mainTitleBar, mainFrame, function()
	-- Keep any open side panel attached to the window's right edge.
	local anchored = UDim2.new(mainFrame.Position.X.Scale, mainFrame.Position.X.Offset + 260,
		mainFrame.Position.Y.Scale, mainFrame.Position.Y.Offset)
	if semiPanel.Visible then
		semiPanel.Position = anchored
	end
	if legitPanel.Visible then
		legitPanel.Position = anchored
	end
end)

