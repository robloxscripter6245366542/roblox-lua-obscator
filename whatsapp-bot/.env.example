# Copy this file to ".env" and fill in your company's details.
# All values are optional — sensible defaults are used if omitted.

COMPANY_NAME=Acme Company
BUSINESS_HOURS=Mon–Fri, 9am–6pm
HUMAN_CONTACT=a team member will reply here as soon as possible

# Re-send the welcome menu at most once per this many milliseconds per chat.
# Default: 6 hours.
GREETING_COOLDOWN_MS=21600000

# Set to "true" to also reply inside group chats. Default: false (1:1 only).
RESPOND_IN_GROUPS=false
