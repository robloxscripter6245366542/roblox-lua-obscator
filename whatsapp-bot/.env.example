# Copy this file to ".env" and fill in your details.
# Only OPENAI_API_KEY and TEAM_NUMBERS really matter to get started.

# ---------------------------------------------------------------- company
COMPANY_NAME=Payfonte
BUSINESS_HOURS=Mon–Fri, 9am–6pm
HUMAN_CONTACT=a team member will reply here as soon as possible

# Country code prepended to local numbers written as "0801...". 234 = Nigeria.
DEFAULT_COUNTRY_CODE=234

# ---------------------------------------------------------------- ChatGPT
# Without this the bot still runs, but only with simple keyword auto-replies.
OPENAI_API_KEY=sk-...

# Any chat model your OpenAI account can access.
OPENAI_MODEL=gpt-5

# Max tool-calling rounds per message. Raise for longer multi-step jobs.
MAX_AGENT_STEPS=8
MAX_HISTORY_MESSAGES=30

# Let customers talk to the AI too (they get a locked-down tool set).
# Set to "false" to give customers the keyword responder instead.
AI_FOR_CUSTOMERS=true

# ------------------------------------------------------------ WHO CAN SEND
# THE SECURITY BOUNDARY. Only these numbers can tell the bot to message other
# people. Everyone else is treated as a customer and gets a reply-only bot.
# Comma-separated. Leave empty and nobody gets send-to-anyone powers.
TEAM_NUMBERS=+2348011111111,+2348022222222

# Where "customer needs a human" alerts go (a number or a group chat id).
ESCALATION_CHAT_ID=

# ------------------------------------------------------------ safety rails
# Require a human "YES" before any message goes to a third party.
# Strongly recommended. Set to "false" for a fully hands-off bot.
REQUIRE_CONFIRMATION=true
CONFIRM_TIMEOUT_MS=600000

# --------------------------------------------------- volume & escalation
# How many chats are handled in parallel. Each one may be an OpenAI call.
CONCURRENCY=8
MAX_QUEUE_PER_CHAT=10

# Send budgets are separate by kind, because the risks differ:
#   replies  = answering someone who messaged us (safe, high volume)
#   internal = paging colleagues about escalations
#   outreach = messaging third parties on instruction (spam risk — keep low)
MAX_REPLIES_PER_HOUR=2000
MAX_INTERNAL_PER_HOUR=200
MAX_SENDS_PER_HOUR=60
MAX_RECIPIENTS_PER_SEND=10

# Page one colleague at most this many times an hour; the rest are batched
# into a digest so a spike of identical questions doesn't bury them.
MAX_ESCALATIONS_PER_HOUR=15
DIGEST_INTERVAL_MS=900000

# Sign relayed answers with the colleague's name ("— Mary, Payfonte").
SIGN_RELAYED_REPLIES=true

# Optional backend for check_reference (order / transaction lookups).
# Receives POST { reference, chatId } and returns any JSON you want shown.
LOOKUP_API_URL=
LOOKUP_API_KEY=

# ------------------------------------------------------- connected apps
# Named targets the bot can push to ("send this to Slack").
# The AI picks a NAME, never a URL, so it can't be talked into posting
# company data to an arbitrary host. Leave blank to disable.
SLACK_WEBHOOK_URL=
INTERNAL_WEBHOOK_URL=

# --------------------------------------------------------------- behaviour
GREETING_COOLDOWN_MS=21600000
RESPOND_IN_GROUPS=false
